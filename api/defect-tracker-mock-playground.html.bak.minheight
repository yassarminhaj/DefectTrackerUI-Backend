/* ----------------------- APP STATE & API CLIENT ------------------------- */
/* Change: dynamic enum support — values resolved at render time from live state.
 * Used by params whose valid values depend on user-mutable data (e.g. workflow statuses). */
const ENUM_PROVIDERS = {
  workflowStatuses() {
    if (!state || !state.provider || !state.provider.db || !state.provider.db.workflow) {
      return ['', 'Assigned', 'InProgress', 'Fixed', 'Test', 'Closed', 'Rejected'];
    }
    const wf = state.provider.db.workflow;
    const fromSet = new Set((wf.transitions || []).map(t => t.fromStatus));
    const toSet = new Set((wf.transitions || []).map(t => t.toStatus));
    const all = [...new Set([...fromSet, ...toSet])].sort();
    return ['', ...all];
  }
};

const state = {
  provider: new MockProvider(),
  current: OPERATIONS[3] /* getCurrentUser */,
  pathValues: {},
  queryValues: {},
  headerValues: {},
  bodyText: '',
  activeTab: 'params',
  activeRTab: 'body'
};

function makeProvider() {
  return CONFIG.useMock ? new MockProvider() : new HttpProvider(CONFIG.baseUrl, CONFIG.bearerToken);
}

/* ----------------------------- UI RENDER -------------------------------- */
const $ = (s) => document.querySelector(s);
const $$ = (s) => Array.from(document.querySelectorAll(s));

function methodClass(m) { return 'm-' + m.toLowerCase(); }

function renderSidebar(filter = '') {
  const list = $('#endpointList');
  list.innerHTML = '';
  const tags = [...new Set(OPERATIONS.map(o => o.tag))];
  const f = filter.trim().toLowerCase();
  tags.forEach(tag => {
    const ops = OPERATIONS.filter(o => o.tag === tag && (!f || (o.path + ' ' + o.summary + ' ' + o.operationId).toLowerCase().includes(f)));
    if (ops.length === 0) return;
    const group = document.createElement('div');
    group.className = 'tag-group';
    const h = document.createElement('h4');
    h.innerHTML = `<span>${tag}</span><span style="font-size:10px;color:var(--text-dim)">${ops.length}</span>`;
    const items = document.createElement('div');
    items.className = 'op-list';
    h.onclick = () => items.classList.toggle('collapsed');
    ops.forEach(op => {
      const row = document.createElement('div');
      row.className = 'op-row' + (op.operationId === state.current.operationId ? ' active' : '');
      row.innerHTML = `<span class="op-method ${methodClass(op.method)}">${op.method}</span><span class="op-path">${op.path}</span>`;
      row.title = op.summary;
      row.onclick = () => selectOp(op);
      items.appendChild(row);
    });
    group.appendChild(h);
    group.appendChild(items);
    list.appendChild(group);
  });
}

function selectOp(op) {
  state.current = op;
  /* Reset values, pre-fill path examples */
  state.pathValues = {};
  state.queryValues = {};
  state.headerValues = {};
  (op.pathParams || []).forEach(p => { state.pathValues[p.name] = p.example || ''; });
  /* Only pre-fill query params that are required or have an explicit default. Examples show as placeholder only — never auto-sent. */
  (op.queryParams || []).forEach(q => { state.queryValues[q.name] = q.default !== undefined ? String(q.default) : (q.required ? (q.example || '') : ''); });
  (op.headerParams || []).forEach(h => { state.headerValues[h.name] = ''; });
  state.bodyText = op.exampleBody ? JSON.stringify(op.exampleBody, null, 2) : '';
  state.activeTab = op.exampleBody ? 'body' : 'params';
  /* clear response */
  $('#respStatus').className = 'status-badge s-idle';
  $('#respStatus').textContent = 'Ready';
  $('#respBody').innerHTML = `<span class="j-null">// Endpoint: ${op.method} ${op.path}\n// ${op.summary}\n// Click Send to execute against the ${CONFIG.useMock ? 'mock' : 'live'} backend.</span>`;
  $('#respHeaders').textContent = '';
  $('#respTime').textContent = '';
  $('#respSize').textContent = '';
  renderRequestBar();
  renderTabs();
  renderSidebar($('#search').value);
}

/* Change 2: parse typed URL back into state.pathValues + state.queryValues */
function parseUrlBarInput(raw) {
  const op = state.current;
  let s = String(raw || "").trim();
  if (s.startsWith(CONFIG.baseUrl)) s = s.slice(CONFIG.baseUrl.length);
  if (!s.startsWith("/")) s = "/" + s;
  const qIdx = s.indexOf("?");
  const pathPart = qIdx === -1 ? s : s.slice(0, qIdx);
  const queryPart = qIdx === -1 ? "" : s.slice(qIdx + 1);
  const tpl = op.path.split("/").filter(Boolean);
  const got = pathPart.split("/").filter(Boolean);
  if (tpl.length === got.length) {
    tpl.forEach((seg, i) => {
      const m = seg.match(/^\{(\w+)\}$/);
      if (m) state.pathValues[m[1]] = decodeURIComponent(got[i]);
    });
  }
  Object.keys(state.queryValues).forEach(k => state.queryValues[k] = "");
  if (queryPart) {
    queryPart.split("&").forEach(p => {
      const [k, v] = p.split("=");
      if (!k) return;
      const key = decodeURIComponent(k);
      const val = v === undefined ? "" : decodeURIComponent(v.replace(/\+/g, " "));
      state.queryValues[key] = val;
    });
  }
  renderTabs();
}

function renderRequestBar() {
  const op = state.current;
  $('#reqMethod').textContent = op.method;
  $('#reqMethod').className = 'method-badge ' + methodClass(op.method);
  const resolved = op.path.replace(/\{(\w+)\}/g, (_, k) => state.pathValues[k] ? state.pathValues[k] : `{${k}}`);
  let qs = '';
  const qparts = [];
  Object.entries(state.queryValues).forEach(([k, v]) => { if (v !== '' && v != null) qparts.push(`${k}=${encodeURIComponent(v)}`); });
  if (qparts.length) qs = '?' + qparts.join('&');
  { const el = $('#reqPath'); if (document.activeElement !== el) el.value = CONFIG.baseUrl + resolved + qs; }
  $('#opSummary').innerHTML = `<strong>${op.operationId}</strong> — ${op.summary}` + (op.note ? `<br><em style="color:var(--warn)">Note: ${op.note}</em>` : '');
}

function renderTabs() {
  const op = state.current;
  $$('.tab').forEach(t => t.classList.toggle('active', t.dataset.tab === state.activeTab));
  $$('.tab-panel').forEach(p => p.classList.toggle('hidden', p.dataset.tab !== state.activeTab));
  /* Counts */
  const pCount = (op.pathParams?.length || 0) + (op.queryParams?.length || 0);
  $('#cntParams').textContent = pCount ? `(${pCount})` : '';
  $('#cntBody').textContent = op.exampleBody ? '(JSON)' : '';

  /* PARAMS panel */
  const pp = $('#panelParams');
  pp.innerHTML = '';
  if (!op.pathParams && !op.queryParams) { pp.innerHTML = '<div class="params-empty">No parameters for this endpoint.</div>'; }
  (op.pathParams || []).forEach(p => pp.appendChild(paramRow('path', p, state.pathValues, () => { state.pathValues[p.name] = arguments[0]; renderRequestBar(); })));
  (op.queryParams || []).forEach(q => pp.appendChild(paramRow('query', q, state.queryValues, () => { state.queryValues[q.name] = arguments[0]; renderRequestBar(); })));

  /* HEADERS panel */
  const hh = $('#panelHeaders');
  hh.innerHTML = '';
  /* Always show Authorization (constant) and any operation-specific headers */
  const authRow = document.createElement('div'); authRow.className = 'param-row';
  authRow.innerHTML = `<label>Authorization</label><input type="text" value="Bearer ${CONFIG.bearerToken}" disabled><span class="hint">always sent</span>`;
  hh.appendChild(authRow);
  (op.headerParams || []).forEach(h => hh.appendChild(paramRow('header', h, state.headerValues)));
  if (!(op.headerParams || []).length) hh.appendChild(Object.assign(document.createElement('div'), { className: 'params-empty', innerText: 'No additional headers required for this endpoint.' }));

  /* BODY panel */
  $('#reqBody').value = state.bodyText;
  $('#bodyInfo').textContent = op.exampleBody ? 'application/json' : '(no body)';

  /* DOCS panel */
  renderDocs(op);
}

function paramRow(kind, p, store) {
  const wrap = document.createElement('div');
  wrap.className = 'param-row';
  const label = document.createElement('label');
  label.textContent = p.name;
  if (kind === 'path' || p.required) { const r = document.createElement('span'); r.className = 'req'; r.textContent = '*'; label.appendChild(r); }
  wrap.appendChild(label);
  let input;
  /* Resolve enum: static p.enum first, then dynamic p.enumProvider via ENUM_PROVIDERS registry. */
  let enumValues = p.enum;
  if (!enumValues && p.enumProvider && ENUM_PROVIDERS[p.enumProvider]) {
    enumValues = ENUM_PROVIDERS[p.enumProvider]();
  }
  if (enumValues) {
    input = document.createElement('select');
    enumValues.forEach(opt => { const o = document.createElement('option'); o.value = opt; o.textContent = opt === '' ? '(none)' : opt; input.appendChild(o); });
  } else {
    input = document.createElement('input');
    input.type = 'text';
    input.placeholder = p.example ? `e.g. ${p.example}` : (p.type || 'string');
  }
  input.value = store[p.name] ?? '';
  input.addEventListener('input', () => { store[p.name] = input.value; renderRequestBar(); });
  input.addEventListener('change', () => { store[p.name] = input.value; renderRequestBar(); });
  wrap.appendChild(input);
  const hint = document.createElement('span');
  hint.className = 'hint';
  const typeLabel = p.type || (enumValues ? 'enum' : 'string');
  hint.textContent = [kind, typeLabel, p.required ? 'required' : '', p.default !== undefined ? `default: ${p.default}` : ''].filter(Boolean).join(' · ');
  wrap.appendChild(hint);
  return wrap;
}

function renderDocs(op) {
  const d = $('#panelDocs');
  let html = `<div class="docs-pane"><h3>${op.method} <code>${op.path}</code></h3>`;
  html += `<p>${op.summary}</p>`;
  html += `<p><strong>operationId:</strong> <code>${op.operationId}</code> · <strong>tag:</strong> ${op.tag}</p>`;
  if (op.pathParams) { html += '<h4>Path parameters</h4><table><thead><tr><th>Name</th><th>Example</th></tr></thead><tbody>' + op.pathParams.map(p => `<tr><td><code>${p.name}</code></td><td><code>${p.example || ''}</code></td></tr>`).join('') + '</tbody></table>'; }
  if (op.queryParams) { html += '<h4>Query parameters</h4><table><thead><tr><th>Name</th><th>Type</th><th>Example / Default</th></tr></thead><tbody>' + op.queryParams.map(q => `<tr><td><code>${q.name}</code></td><td>${q.type || (q.enum ? 'enum' : 'string')}</td><td><code>${q.example !== undefined ? q.example : (q.default !== undefined ? q.default : (q.enum ? q.enum.join(' | ') : ''))}</code></td></tr>`).join('') + '</tbody></table>'; }
  if (op.headerParams) { html += '<h4>Headers</h4><table><thead><tr><th>Name</th><th>Values</th></tr></thead><tbody>' + op.headerParams.map(h => `<tr><td><code>${h.name}</code></td><td><code>${h.enum ? h.enum.join(' | ') : 'string'}</code></td></tr>`).join('') + '</tbody></table>'; }
  if (op.exampleBody) { html += '<h4>Example request body</h4><pre style="background:var(--code-bg);padding:12px;border-radius:5px;overflow:auto"><code>' + escapeHtml(JSON.stringify(op.exampleBody, null, 2)) + '</code></pre>'; }
  if (op.note) { html += `<p style="color:var(--warn)"><em>${op.note}</em></p>`; }
  html += '</div>';
  d.innerHTML = html;
}

function escapeHtml(s) { return String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c])); }

function syntaxHighlight(json) {
  if (typeof json !== 'string') json = JSON.stringify(json, null, 2);
  const re = /("(?:\\u[a-fA-F0-9]{4}|\\[^u]|[^\\"])*"(\s*:)?|\b(true|false|null)\b|-?\d+(?:\.\d*)?(?:[eE][+\-]?\d+)?)/g;
  let out = '';
  let lastIndex = 0;
  let m;
  while ((m = re.exec(json)) !== null) {
    out += escapeHtml(json.slice(lastIndex, m.index));
    const tok = m[0];
    let cls = 'j-num';
    if (/^"/.test(tok)) cls = /:$/.test(tok) ? 'j-key' : 'j-str';
    else if (/^true|^false/.test(tok)) cls = 'j-bool';
    else if (/^null/.test(tok)) cls = 'j-null';
    if (cls === 'j-str') {
      const um = tok.match(/^"([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})"$/i);
      if (um) { out += `<span class="${cls} j-copyable" data-copy="${um[1]}" title="Click to copy">${escapeHtml(tok)}</span>`; lastIndex = m.index + tok.length; continue; }
    }
    out += `<span class="${cls}">${escapeHtml(tok)}</span>`;
    lastIndex = m.index + tok.length;
  }
  out += escapeHtml(json.slice(lastIndex));
  return out;
}

async function sendRequest() {
  const op = state.current;
  /* Collect inputs */
  const req = { path: { ...state.pathValues }, query: { ...state.queryValues }, headers: { ...state.headerValues } };
  Object.keys(req.headers).forEach(k => { if (!req.headers[k]) delete req.headers[k]; });
  Object.keys(req.query).forEach(k => { if (req.query[k] === '' || req.query[k] == null) delete req.query[k]; });
  /* Parse body */
  if (state.bodyText && state.bodyText.trim()) {
    try { req.body = JSON.parse(state.bodyText); }
    catch (e) {
      flashStatus(400, 'Invalid JSON body');
      $('#respBody').innerHTML = `<span class="j-null">// JSON parse error: ${escapeHtml(e.message)}</span>`;
      return;
    }
  }
  /* Sync body text from textarea */
  state.bodyText = $('#reqBody').value;
  if (state.bodyText.trim()) {
    try { req.body = JSON.parse(state.bodyText); }
    catch (e) {
      flashStatus(400, 'Invalid JSON body');
      $('#respBody').innerHTML = `<span class="j-null">// JSON parse error: ${escapeHtml(e.message)}</span>`;
      return;
    }
  }
  flashStatus(0, 'Sending…');
  const res = await state.provider.call(op.operationId, req);
  renderResponse(res);
}

function renderResponse(res) {
  const s = res.status;
  const elem = $('#respStatus');
  let cls = 's-idle', label = `${s}`;
  if (s >= 200 && s < 300) { cls = 's-2xx'; label = `${s} OK`; }
  else if (s >= 400 && s < 500) { cls = 's-4xx'; label = `${s} Client Error`; }
  else if (s >= 500) { cls = 's-5xx'; label = `${s} Server Error`; }
  else if (s === 0) { cls = 's-5xx'; label = `Network`; }
  elem.className = 'status-badge ' + cls;
  elem.textContent = label;
  $('#respTime').textContent = (res.elapsedMs != null ? `${res.elapsedMs} ms` : '');
  const bodyStr = res.body == null ? '' : (typeof res.body === 'string' ? res.body : JSON.stringify(res.body, null, 2));
  $('#respSize').textContent = bodyStr ? `${new Blob([bodyStr]).size} B` : '0 B';
  if (s === 204 || res.body == null) {
    $('#respBody').innerHTML = '<span class="j-null">// No content (204)</span>';
  } else if (typeof res.body === 'object') {
    $('#respBody').innerHTML = syntaxHighlight(res.body);
  } else {
    $('#respBody').textContent = bodyStr;
  }
  $('#respHeaders').textContent = JSON.stringify(res.headers || {}, null, 2);
}

function flashStatus(code, label) {
  const elem = $('#respStatus');
  elem.className = 'status-badge ' + (code === 0 ? 's-idle' : 's-4xx');
  elem.textContent = label;
}

function toast(msg) {
  const t = document.createElement('div');
  t.className = 'toast';
  t.textContent = msg;
  document.body.appendChild(t);
  setTimeout(() => t.remove(), 2200);
}

/* ----------------------------- WIRE UI ---------------------------------- */
function attachUI() {
  $('#search').addEventListener('input', e => renderSidebar(e.target.value));

  $$('.tab').forEach(t => t.addEventListener('click', () => {
    state.activeTab = t.dataset.tab;
    renderTabs();
  }));
  $$('.rtab').forEach(t => t.addEventListener('click', () => {
    state.activeRTab = t.dataset.rtab;
    $$('.rtab').forEach(x => x.classList.toggle('active', x === t));
    $('#respBody').classList.toggle('hidden', state.activeRTab !== 'body');
    $('#respHeaders').classList.toggle('hidden', state.activeRTab !== 'headers');
  }));

  $('#sendBtn').addEventListener('click', sendRequest);
  $('#reqPath').addEventListener('input', e => parseUrlBarInput(e.target.value));
  $('#reqPath').addEventListener('focus', e => e.target.select());
  /* Change 3: click any UUID in the response to copy it */
  $('#respBody').addEventListener('click', e => {
    const t = e.target.closest && e.target.closest('.j-copyable');
    if (!t) return;
    const val = t.dataset.copy;
    if (navigator.clipboard && navigator.clipboard.writeText) { navigator.clipboard.writeText(val).then(() => toast('Copied: ' + val)); }
    else { try { const ta = document.createElement('textarea'); ta.value = val; document.body.appendChild(ta); ta.select(); document.execCommand('copy'); document.body.removeChild(ta); toast('Copied: ' + val); } catch { toast('Copy not supported'); } }
  });
  $('#reqBody').addEventListener('input', e => state.bodyText = e.target.value);
  $('#loadExampleBtn').addEventListener('click', () => {
    if (state.current.exampleBody) {
      state.bodyText = JSON.stringify(state.current.exampleBody, null, 2);
      $('#reqBody').value = state.bodyText;
      toast('Example body loaded');
    } else toast('No example body for this endpoint');
  });
  $('#prettyBtn').addEventListener('click', () => {
    try { const parsed = JSON.parse($('#reqBody').value); $('#reqBody').value = JSON.stringify(parsed, null, 2); state.bodyText = $('#reqBody').value; toast('Formatted'); }
    catch (e) { toast('Cannot format: invalid JSON'); }
  });

  $('#resetBtn').addEventListener('click', () => {
    state.provider = makeProvider();
    toast('Data reset to seed.');
  });

  $('#modeBtn').addEventListener('click', () => {
    CONFIG.useMock = !CONFIG.useMock;
    state.provider = makeProvider();
    $('#modePill').textContent = CONFIG.useMock ? 'Mock Mode' : 'Live Mode';
    $('#modePill').classList.toggle('live', !CONFIG.useMock);
    $('#modeBtn').textContent = CONFIG.useMock ? 'Switch to Live' : 'Switch to Mock';
    toast(CONFIG.useMock ? 'Switched to Mock provider' : `Switched to Live: ${CONFIG.baseUrl}`);
  });

  /* Resizable response pane + resizable sidebar (both Postman-style, persisted in sessionStorage). */
  attachResponseResize();
  attachSidebarResize();
}

function attachSidebarResize() {
  const handle = document.getElementById('sidebarResize');
  const layout = document.querySelector('.layout');
  if (!handle || !layout) return;

  const DEFAULT_W = 320;
  const MIN_W = 180;
  const MAX_W = 600;
  const setCols = (w) => { layout.style.gridTemplateColumns = `${w}px 6px 1fr`; };

  /* Restore saved width. */
  try {
    const saved = sessionStorage.getItem('dt_sidebarWidth');
    if (saved) setCols(Math.min(MAX_W, Math.max(MIN_W, parseInt(saved, 10))));
  } catch (e) { /* ignore */ }

  let dragging = false, startX = 0, startW = 0;
  handle.addEventListener('mousedown', e => {
    dragging = true;
    startX = e.clientX;
    /* Read current sidebar width from the actual grid track. */
    const sidebar = document.querySelector('.sidebar');
    startW = sidebar.getBoundingClientRect().width;
    handle.classList.add('dragging');
    document.body.style.cursor = 'col-resize';
    document.body.style.userSelect = 'none';
    e.preventDefault();
  });

  document.addEventListener('mousemove', e => {
    if (!dragging) return;
    const delta = e.clientX - startX;
    const newW = Math.min(MAX_W, Math.max(MIN_W, startW + delta));
    setCols(newW);
  });

  document.addEventListener('mouseup', () => {
    if (!dragging) return;
    dragging = false;
    handle.classList.remove('dragging');
    document.body.style.cursor = '';
    document.body.style.userSelect = '';
    try {
      const w = Math.round(document.querySelector('.sidebar').getBoundingClientRect().width);
      sessionStorage.setItem('dt_sidebarWidth', String(w));
    } catch (e) { /* ignore */ }
  });

  handle.addEventListener('dblclick', () => {
    setCols(DEFAULT_W);
    try { sessionStorage.removeItem('dt_sidebarWidth'); } catch (e) { /* ignore */ }
    toast('Sidebar width reset');
  });
}

function attachResponseResize() {
  const handle = document.getElementById('responseResize');
  const pane = document.getElementById('responsePane');
  const workspace = document.querySelector('.workspace');
  if (!handle || !pane || !workspace) return;

  /* Restore saved height (per-tab session). */
  try {
    const saved = sessionStorage.getItem('dt_responsePaneHeight');
    if (saved) pane.style.flex = `0 0 ${parseInt(saved, 10)}px`;
  } catch (e) { /* sessionStorage may be disabled — gracefully ignore */ }

  let dragging = false, startY = 0, startHeight = 0;

  handle.addEventListener('mousedown', e => {
    dragging = true;
    startY = e.clientY;
    startHeight = pane.getBoundingClientRect().height;
    handle.classList.add('dragging');
    document.body.style.cursor = 'row-resize';
    document.body.style.userSelect = 'none';
    e.preventDefault();
  });

  document.addEventListener('mousemove', e => {
    if (!dragging) return;
    /* Dragging up (clientY decreases) grows the response pane. */
    const delta = startY - e.clientY;
    const wsHeight = workspace.getBoundingClientRect().height;
    const newHeight = Math.min(Math.max(50, startHeight + delta), wsHeight - 80);
    pane.style.flex = `0 0 ${newHeight}px`;
  });

  document.addEventListener('mouseup', () => {
    if (!dragging) return;
    dragging = false;
    handle.classList.remove('dragging');
    document.body.style.cursor = '';
    document.body.style.userSelect = '';
    /* Persist the chosen height for this session. */
    try {
      const h = Math.round(pane.getBoundingClientRect().height);
      sessionStorage.setItem('dt_responsePaneHeight', String(h));
    } catch (e) { /* ignore */ }
  });

  /* Double-click the handle to reset to default (50/50). */
  handle.addEventListener('dblclick', () => {
    pane.style.flex = '';
    try { sessionStorage.removeItem('dt_responsePaneHeight'); } catch (e) { /* ignore */ }
    toast('Response pane height reset');
  });
}

/* ----------------------------- BOOT ------------------------------------- */
attachUI();
renderSidebar();
selectOp(OPERATIONS.find(o => o.operationId === 'listDefects'));
</script>
</body>
</html>
