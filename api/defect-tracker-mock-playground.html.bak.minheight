        if (!allowed.includes(ext)) return this._err(400, 'validation_error', 'Unsupported file extension');
        const a = { id: uuid(), defectId: d.id, originalFilename: fn, storageKey: `defects/${d.defectKey}/attachments/${fn}`, contentType: B.contentType || 'application/octet-stream', fileExtension: ext, fileSizeBytes: B.fileSizeBytes || 12345, uploadedByUserId: db.users[0].id, uploadedAt: nowIso(), isDeleted: false };
        db.attachments.push(a);
