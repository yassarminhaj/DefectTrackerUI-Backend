/* ----------------------------- HELPERS ---------------------------------- */
function uuid() {
  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => {
    const r = Math.random() * 16 | 0, v = c == 'x' ? r : (r & 0x3 | 0x8);
    return v.toString(16);
  });
}
function nowIso() { return new Date().toISOString(); }
function nextDefectKey(defects) {
  const nums = defects.map(d => parseInt((d.defectKey || '').replace(/^DF-/, ''), 10)).filter(n => !isNaN(n));
  return 'DF-' + ((nums.length ? Math.max(...nums) : 1041) + 1);
}
function clone(o) { return JSON.parse(JSON.stringify(o)); }
function findById(list, id) { return list.find(x => String(x.id) === String(id)); }
function userSummary(u) {
  if (!u) return null;
  return { id: u.id, name: u.name, username: u.username, email: u.email };
}
function paginate(items, page, pageSize) {
  page = Number(page) || 1;
  pageSize = Number(pageSize) || 10;
  const total = items.length;
  const totalPages = Math.max(1, Math.ceil(total / pageSize));
  const start = (page - 1) * pageSize;
  return { items: items.slice(start, start + pageSize), pagination: { page, pageSize, total, totalPages } };
}

/* ------------------------ DATAPROVIDER INTERFACE ------------------------ */
/* Both providers expose: async call(operationId, requestSpec) → { status, headers, body } */

/* ----------------------- TYPED VALIDATION ------------------------------ */
/* Schema-driven validation matching the OpenAPI contract + PostgreSQL
 * constraints. Strict types — isActive must be true|false (not 1, not "true"),
 * enums must match exactly, UUIDs must look like UUIDs, etc.               */
const V = {
  TYPES: {
    string: v => typeof v === 'string',
    boolean: v => typeof v === 'boolean',
    integer: v => typeof v === 'number' && Number.isInteger(v),
    uuid: v => typeof v === 'string' && /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(v),
    email: v => typeof v === 'string' && /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(v),
    date: v => typeof v === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(v),
    object: v => v !== null && typeof v === 'object' && !Array.isArray(v)
  },
  field(name, value, spec) {
    if (value === null) {
      if (spec.nullable) return null;
      return `${name} must not be null`;
    }
    const validator = this.TYPES[spec.type];
    if (validator && !validator(value)) {
      const got = Array.isArray(value) ? 'array' : (value === null ? 'null' : typeof value);
      return `${name} must be ${spec.type} (got ${got}: ${JSON.stringify(value).slice(0, 40)})`;
    }
    if (spec.enum && !spec.enum.includes(value)) {
      return `${name} must be one of [${spec.enum.join(', ')}] (got ${JSON.stringify(value)})`;
    }
    if (['string', 'uuid', 'email', 'date'].includes(spec.type)) {
      if (spec.minLength != null && value.length < spec.minLength) return `${name} must be at least ${spec.minLength} characters`;
      if (spec.maxLength != null && value.length > spec.maxLength) return `${name} must be at most ${spec.maxLength} characters`;
    }
    if (spec.type === 'integer') {
      if (spec.min != null && value < spec.min) return `${name} must be >= ${spec.min}`;
      if (spec.max != null && value > spec.max) return `${name} must be <= ${spec.max}`;
    }
    return null;
  },
  body(body, schema, partial = false) {
    if (body === undefined || body === null) {
      if (!partial && schema.required && schema.required.length) return 'Request body is required';
      return null;
    }
    if (typeof body !== 'object' || Array.isArray(body)) return 'Request body must be a JSON object';
    if (!partial) {
      for (const f of (schema.required || [])) {
        if (body[f] === undefined) return `Missing required field: ${f}`;
      }
    }
    for (const [name, value] of Object.entries(body)) {
      const spec = schema.fields[name];
      if (!spec || value === undefined) continue;
      const err = this.field(name, value, spec);
      if (err) return err;
    }
    return null;
  }
};

const SCHEMAS = {
  login: { fields: {
    username: { type: 'string', minLength: 3, maxLength: 80 },
    password: { type: 'string', minLength: 8, maxLength: 128 },
    dataContext: { type: 'string', enum: ['Test', 'Prod', 'All'] }
  }, required: ['username', 'password'] },
  refresh: { fields: { refreshToken: { type: 'string', minLength: 1 } }, required: ['refreshToken'] },
  logout: { fields: { refreshToken: { type: 'string' } } },
  profileUpdate: { fields: { email: { type: 'email', maxLength: 255 } }, required: ['email'] },
  passwordChange: { fields: {
    previousPassword: { type: 'string', minLength: 8, maxLength: 128 },
    newPassword: { type: 'string', minLength: 8, maxLength: 128 },
    confirmPassword: { type: 'string', minLength: 8, maxLength: 128 }
  }, required: ['previousPassword', 'newPassword', 'confirmPassword'] },
  userCreate: { fields: {
    name: { type: 'string', minLength: 2, maxLength: 120 },
    email: { type: 'email', maxLength: 255 },
    username: { type: 'string', minLength: 3, maxLength: 80 },
    password: { type: 'string', minLength: 8, maxLength: 128 },
    confirmPassword: { type: 'string', minLength: 8, maxLength: 128 },
    isActive: { type: 'boolean' },
    defaultDataContext: { type: 'string', enum: ['Test', 'Prod', 'All'] }
  }, required: ['name', 'email', 'username', 'password', 'confirmPassword', 'isActive'] },
  userUpdate: { fields: {
    name: { type: 'string', minLength: 2, maxLength: 120 },
    email: { type: 'email', maxLength: 255 },
    username: { type: 'string', minLength: 3, maxLength: 80 },
    isActive: { type: 'boolean' },
    defaultDataContext: { type: 'string', enum: ['Test', 'Prod', 'All'] }
  } },
  userPasswordReset: { fields: {
    newPassword: { type: 'string', minLength: 8, maxLength: 128 },
    confirmPassword: { type: 'string', minLength: 8, maxLength: 128 }
  }, required: ['newPassword', 'confirmPassword'] },
  project: { fields: {
    projectName: { type: 'string', minLength: 2, maxLength: 120 },
    description: { type: 'string', maxLength: 500, nullable: true },
    isActive: { type: 'boolean' }
  }, required: ['projectName', 'isActive'] },
  environment: { fields: {
    environmentName: { type: 'string', minLength: 2, maxLength: 50 },
    environmentScope: { type: 'string', enum: ['Test', 'Prod'] },
    description: { type: 'string', maxLength: 500, nullable: true },
    isActive: { type: 'boolean' },
    sortOrder: { type: 'integer', min: 0 }
  }, required: ['environmentName', 'environmentScope', 'isActive'] },
  release: { fields: {
    projectId: { type: 'uuid' },
    releaseVersion: { type: 'string', minLength: 1, maxLength: 80 },
    plannedDeploymentDate: { type: 'date', nullable: true },
    actualDeploymentDate: { type: 'date', nullable: true },
    isActive: { type: 'boolean' }
  }, required: ['projectId', 'releaseVersion', 'isActive'] },
  workflowSave: { fields: {
    workflowName: { type: 'string', minLength: 1, maxLength: 120 },
    diagram: { type: 'object' }
  }, required: ['workflowName', 'diagram'] },
  defectCreate: { fields: {
    title: { type: 'string', minLength: 3, maxLength: 200 },
    description: { type: 'string', minLength: 5 },
    projectId: { type: 'uuid' },
    moduleComponent: { type: 'string', maxLength: 120, nullable: true },
    environmentId: { type: 'uuid' },
    severityId: { type: 'integer' },
    priorityId: { type: 'integer' },
    assignedToUserId: { type: 'uuid' },
    stepsHtml: { type: 'string', nullable: true },
    expectedResult: { type: 'string', minLength: 2, maxLength: 1500 },
    actualResult: { type: 'string', minLength: 2, maxLength: 1500 }
  }, required: ['title', 'description', 'projectId', 'environmentId', 'severityId', 'priorityId', 'assignedToUserId', 'expectedResult', 'actualResult'] },
  defectUpdate: { fields: {
    title: { type: 'string', minLength: 3, maxLength: 200 },
    description: { type: 'string', minLength: 5 },
    projectId: { type: 'uuid' },
    moduleComponent: { type: 'string', maxLength: 120, nullable: true },
    environmentId: { type: 'uuid' },
    severityId: { type: 'integer' },
    priorityId: { type: 'integer' },
    currentStatus: { type: 'string', maxLength: 120 },
    assignedToUserId: { type: 'uuid' },
    stepsHtml: { type: 'string', nullable: true },
    expectedResult: { type: 'string', minLength: 2, maxLength: 1500 },
    actualResult: { type: 'string', minLength: 2, maxLength: 1500 },
    fixedInReleaseId: { type: 'uuid', nullable: true },
    fixDate: { type: 'date', nullable: true },
    closureDate: { type: 'date', nullable: true }
  } },
  commentCreate: { fields: { commentText: { type: 'string', minLength: 1, maxLength: 4000 } }, required: ['commentText'] },
  commentUpdate: { fields: { commentText: { type: 'string', minLength: 1, maxLength: 4000 } }, required: ['commentText'] },
  attachmentUpload: { fields: {
    filename: { type: 'string', minLength: 1, maxLength: 255 },
    contentType: { type: 'string' },
    fileSizeBytes: { type: 'integer', min: 0 }
  } },
  inlineAssetUpload: { fields: {
    filename: { type: 'string', minLength: 1, maxLength: 255 },
    contentType: { type: 'string', enum: ['image/png', 'image/jpeg'] },
    fileSizeBytes: { type: 'integer', min: 0 },
    widthPx: { type: 'integer', min: 1 },
    heightPx: { type: 'integer', min: 1 }
  } },
  inlineAssetUpdate: { fields: {
    widthPx: { type: 'integer', min: 1 },
    heightPx: { type: 'integer', min: 1 }
  } }
};

class HttpProvider {
  constructor(baseUrl, token) { this.baseUrl = baseUrl; this.token = token; }
  async call(operationId, req) {
    const op = OPERATIONS.find(o => o.operationId === operationId);
    if (!op) return { status: 404, headers: {}, body: { code: 'unknown_operation', message: operationId } };
    let path = op.path.replace(/\{(\w+)\}/g, (_, k) => encodeURIComponent(req.path?.[k] ?? ''));
    const qs = new URLSearchParams();
    for (const [k, v] of Object.entries(req.query || {})) { if (v !== '' && v != null) qs.append(k, v); }
    const url = this.baseUrl + path + (qs.toString() ? `?${qs}` : '');
    const headers = { 'Content-Type': 'application/json', 'Authorization': `Bearer ${this.token}`, ...(req.headers || {}) };
    const init = { method: op.method, headers };
    if (req.body && op.method !== 'GET') init.body = typeof req.body === 'string' ? req.body : JSON.stringify(req.body);
    const t0 = performance.now();
    try {
      const res = await fetch(url, init);
      const text = await res.text();
      let body; try { body = JSON.parse(text); } catch { body = text; }
      const respHeaders = {}; res.headers.forEach((v, k) => respHeaders[k] = v);
      return { status: res.status, headers: respHeaders, body, elapsedMs: Math.round(performance.now() - t0) };
    } catch (e) {
      return { status: 0, headers: {}, body: { code: 'network_error', message: String(e) }, elapsedMs: Math.round(performance.now() - t0) };
    }
  }
}

class MockProvider {
  constructor() { this.reset(); }
  reset() { this.db = SEED_FACTORY(); }

  /* --- internal joins --- */
  _defectSummary(d) {
    return {
      id: d.id, defectKey: d.defectKey, title: d.title,
      project: findById(this.db.projects, d.projectId) || null,
      environment: findById(this.db.environments, d.environmentId) || null,
      severity: this._lookup(this.db.severityLevels, d.severityId),
      priority: this._lookup(this.db.priorityLevels, d.priorityId),
      currentStatus: d.currentStatus,
      assignedTo: userSummary(findById(this.db.users, d.assignedToUserId)),
      createdBy:  userSummary(findById(this.db.users, d.createdByUserId)),
      fixedInRelease: d.fixedInReleaseId ? findById(this.db.releases, d.fixedInReleaseId) : null,
      fixDate: d.fixDate, closureDate: d.closureDate,
      createdAt: d.createdAt, updatedAt: d.updatedAt
    };
  }
  _lookup(arr, id) { const x = findById(arr, id); return x ? { id: x.id, name: x.name, rank: x.rank, colorToken: x.colorToken || null, isActive: x.isActive } : null; }
  _allowedNext(currentStatus) { return this.db.workflow.transitions.filter(t => t.isActive && t.fromStatus === currentStatus).map(t => t.toStatus); }
  _initialStatus() {
    const tx = this.db.workflow.transitions.filter(t => t.isActive);
    const fromSet = new Set(tx.map(t => t.fromStatus));
    const toSet = new Set(tx.map(t => t.toStatus));
    const entries = [...fromSet].filter(s => !toSet.has(s));
    return entries[0] || (tx[0] && tx[0].fromStatus) || 'Assigned';
  }
  _attachmentDto(a) {
    const u = findById(this.db.users, a.uploadedByUserId);
    return { id: a.id, defectId: a.defectId, originalFilename: a.originalFilename, contentType: a.contentType, fileExtension: a.fileExtension, fileSizeBytes: a.fileSizeBytes, contentUrl: `/api/v1/defects/${a.defectId}/attachments/${a.id}/content`, uploadedBy: userSummary(u), uploadedAt: a.uploadedAt };
  }
  _inlineAssetDto(a) {
    return { id: a.id, defectId: a.defectId, assetKind: a.assetKind, originalFilename: a.originalFilename, contentType: a.contentType, fileSizeBytes: a.fileSizeBytes, widthPx: a.widthPx, heightPx: a.heightPx, contentUrl: `/api/v1/defects/${a.defectId}/inline-assets/${a.id}/content`, createdAt: a.createdAt };
  }
  _commentDto(c) {
    return { id: c.id, defectId: c.defectId, commentText: c.commentText, createdBy: userSummary(findById(this.db.users, c.createdByUserId)), createdAt: c.createdAt, updatedAt: c.updatedAt };
  }
  _defectDetail(d) {
    const summary = this._defectSummary(d);
    const ver = d.version || 1;
    return {
      ...summary,
      description: d.description,
      moduleComponent: d.moduleComponent,
      stepsHtml: d.stepsHtml,
      expectedResult: d.expectedResult,
      actualResult: d.actualResult,
      version: ver,
      etag: `W/"${ver}"`,
      allowedNextStatuses: this._allowedNext(d.currentStatus),
      attachments: this.db.attachments.filter(a => a.defectId === d.id && !a.isDeleted).map(a => this._attachmentDto(a)),
      inlineAssets: this.db.inlineAssets.filter(a => a.defectId === d.id && !a.isDeleted).map(a => this._inlineAssetDto(a)),
      comments: this.db.comments.filter(c => c.defectId === d.id && !c.isDeleted).map(c => this._commentDto(c))
    };
  }
  _ok(body, status = 200) { return { status, headers: { 'content-type': 'application/json' }, body }; }
  _err(status, code, message, details) { return { status, headers: { 'content-type': 'application/json' }, body: { code, message, details } }; }

  async call(operationId, req) {
    const t0 = performance.now();
    const ctx = req || {};
    const P = ctx.path || {}, Q = ctx.query || {}, B = ctx.body || {};
    let r;
    try {
      r = this._dispatch(operationId, P, Q, B, ctx.headers || {});
    } catch (e) {
      r = this._err(500, 'mock_handler_error', String(e));
    }
    r.elapsedMs = Math.round(performance.now() - t0);
    return r;
  }

  _dispatch(op, P, Q, B, H) {
    const db = this.db;
    switch (op) {
      /* ============================== AUTH ============================== */
      case 'login': {
        { const err = V.body(B, SCHEMAS.login); if (err) return this._err(400, 'validation_error', err); }
        const user = db.users.find(u => u.username === B.username) || db.users[0];
        return this._ok({
          accessToken: 'mock.jwt.' + uuid(),
          refreshToken: 'mock.refresh.' + uuid(),
          tokenType: 'Bearer',
          expiresIn: 1800,
          activeDataContext: B.dataContext || user.defaultDataContext,
          user: userSummary(user)
        });
      }
      case 'refreshToken': {
        { const err = V.body(B, SCHEMAS.refresh); if (err) return this._err(400, 'validation_error', err); }
        return this._ok({
