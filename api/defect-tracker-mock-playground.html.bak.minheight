      }
      case 'listWorkflowTransitions': {
        /* Sharpened: fromStatus is REQUIRED. Endpoint answers "for status X, what's next?"
         * Distinct from GET /workflow (whole diagram) and from defect.allowedNextStatuses (defect-bound). */
        if (!Q.fromStatus) {
          const valid = [...new Set(this.db.workflow.transitions.map(t => t.fromStatus))];
          return this._err(400, 'validation_error', `fromStatus is required. Valid values: [${valid.join(', ')}]`);
        }
        const validFrom = new Set(this.db.workflow.transitions.map(t => t.fromStatus));
        const validTo = new Set(this.db.workflow.transitions.map(t => t.toStatus));
        const allStatuses = new Set([...validFrom, ...validTo]);
        if (!allStatuses.has(Q.fromStatus)) {
          return this._err(400, 'validation_error', `fromStatus '${Q.fromStatus}' is not a status in the active workflow. Valid: [${[...allStatuses].join(', ')}]`);
        }
        const items = this.db.workflow.transitions.filter(t => t.isActive && t.fromStatus === Q.fromStatus);
        const allowedStatuses = items.map(t => t.toStatus);
        return this._ok({ currentStatus: Q.fromStatus, allowedStatuses, items });
      }

