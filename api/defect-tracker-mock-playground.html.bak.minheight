        /* Regenerate transitions from diagram edges */
        const labelById = Object.fromEntries((B.diagram.nodes || []).map(n => [n.id, n.label]));
        this.db.workflow.transitions = (B.diagram.edges || []).map((e, i) => ({
          id: uuid(), fromStatus: labelById[e.source] || e.source, toStatus: labelById[e.target] || e.target, displayOrder: i + 1, isActive: true
        }));
