        if (Q.assignedToUserId) items = items.filter(d => d.assignedToUserId === Q.assignedToUserId);
        if (Q.releaseId)        items = items.filter(d => d.fixedInReleaseId === Q.releaseId);
        items.sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));
