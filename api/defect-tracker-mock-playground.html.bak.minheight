        a.isDeleted = true;
        db.historyEvents.push({ id: uuid(), defectId: a.defectId, eventBatchId: uuid(), eventType: 'attachment_deleted', fieldName: 'attachment', oldValue: a.originalFilename, newValue: null, metadata: { attachment_id: a.id }, actorUserId: db.users[0].id, createdAt: nowIso() });
        return { status: 204, headers: {}, body: null };
      }
