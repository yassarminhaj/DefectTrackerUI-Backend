        c.commentText = B.commentText; c.updatedAt = nowIso();
        db.historyEvents.push({ id: uuid(), defectId: c.defectId, eventBatchId: uuid(), eventType: 'comment_updated', fieldName: 'comment', oldValue: null, newValue: B.commentText.slice(0, 80), metadata: { comment_id: c.id }, actorUserId: db.users[0].id, createdAt: nowIso() });
        return this._ok(this._commentDto(c));
