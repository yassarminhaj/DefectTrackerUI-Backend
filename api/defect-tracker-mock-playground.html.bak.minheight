      case 'deleteDefectComment': {
        const c = findById(db.comments, P.commentId);
        if (!c || c.isDeleted || c.defectId !== P.defectId) return this._err(404, 'not_found', 'Comment not found');
        c.isDeleted = true;
        db.historyEvents.push({ id: uuid(), defectId: c.defectId, eventBatchId: uuid(), eventType: 'comment_deleted', fieldName: 'comment', oldValue: c.commentText.slice(0, 80), newValue: null, metadata: { comment_id: c.id }, actorUserId: db.users[0].id, createdAt: nowIso() });
        return { status: 204, headers: {}, body: null };
      }

      /* ============================= HISTORY ============================ */
      case 'listDefectHistory': {
        const d = findById(db.defects, P.defectId);
        if (!d) return this._err(404, 'not_found', 'Defect not found');
        const items = db.historyEvents.filter(h => h.defectId === d.id).sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt))
          .map(h => ({ id: h.id, eventBatchId: h.eventBatchId, eventType: h.eventType, fieldName: h.fieldName, oldValue: h.oldValue, newValue: h.newValue, metadata: h.metadata, actor: userSummary(findById(db.users, h.actorUserId)), createdAt: h.createdAt }));
        const p = paginate(items, Q.page, Q.pageSize);
        return this._ok({ items: p.items, pagination: p.pagination });
      }

      /* ============================ DASHBOARD =========================== */
      case 'getDashboardSummary': {
        const ctx = H['X-Data-Context'] || 'All';
        let items = db.defects.filter(d => !d.isDeleted);
        if (ctx === 'Test' || ctx === 'Prod') items = items.filter(d => { const e = findById(db.environments, d.environmentId); return e && e.environmentScope === ctx; });
        const byStatus = {}, bySeverity = {}, byPriority = {};
        items.forEach(d => {
          byStatus[d.currentStatus] = (byStatus[d.currentStatus] || 0) + 1;
          const s = findById(db.severityLevels, d.severityId)?.name || 'Unknown';
          bySeverity[s] = (bySeverity[s] || 0) + 1;
          const p = findById(db.priorityLevels, d.priorityId)?.name || 'Unknown';
          byPriority[p] = (byPriority[p] || 0) + 1;
        });
        const open = items.filter(d => !['Closed', 'Rejected'].includes(d.currentStatus)).length;
        const closed = items.filter(d => d.currentStatus === 'Closed').length;
        return this._ok({ activeDataContext: ctx, total: items.length, open, closed, byStatus, bySeverity, byPriority });
      }
      case 'getDashboardCharts': {
        const ctx = H['X-Data-Context'] || 'All';
        let items = db.defects.filter(d => !d.isDeleted);
        if (ctx === 'Test' || ctx === 'Prod') items = items.filter(d => { const e = findById(db.environments, d.environmentId); return e && e.environmentScope === ctx; });
        const byProject = {}, byEnv = {}, byStatus = {};
        items.forEach(d => {
          const proj = findById(db.projects, d.projectId)?.projectName || '—';
          const env = findById(db.environments, d.environmentId)?.environmentName || '—';
          byProject[proj] = (byProject[proj] || 0) + 1;
          byEnv[env] = (byEnv[env] || 0) + 1;
          byStatus[d.currentStatus] = (byStatus[d.currentStatus] || 0) + 1;
        });
        const trend = []; const today = new Date('2026-05-14T00:00:00Z');
        for (let i = 6; i >= 0; i--) {
          const date = new Date(today); date.setDate(date.getDate() - i);
          const iso = date.toISOString().slice(0, 10);
          trend.push({ date: iso, opened: items.filter(d => d.createdAt.slice(0, 10) === iso).length });
        }
        return this._ok({ activeDataContext: ctx, byProject, byEnvironment: byEnv, byStatus, weeklyOpenTrend: trend });
      }

      default:
        return this._err(404, 'unknown_operation', `Operation '${op}' is not implemented in the mock router.`);
    }
  }
}

