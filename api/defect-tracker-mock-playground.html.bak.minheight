<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Defect Tracker — Mock API Playground</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
  :root {
    --bg: #0f1115;
    --panel: #161a22;
    --panel-2: #1c2230;
    --border: #262d3a;
    --text: #e6e9ef;
    --text-dim: #95a0b3;
    --accent: #6ea8ff;
    --accent-2: #8af0c9;
    --get: #2dd4bf;
    --post: #facc15;
    --put: #a78bfa;
    --patch: #fb923c;
    --delete: #f87171;
    --ok: #22c55e;
    --warn: #f59e0b;
    --err: #ef4444;
    --code-bg: #0b0e14;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; height: 100%; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: var(--bg); color: var(--text); font-size: 13px; }
  .topbar { height: 48px; background: var(--panel); border-bottom: 1px solid var(--border); display: flex; align-items: center; padding: 0 16px; gap: 14px; }
  .brand { font-weight: 600; letter-spacing: 0.2px; color: var(--text); }
  .brand span { color: var(--accent); }
  .topbar-right { margin-left: auto; display: flex; gap: 10px; align-items: center; }
  .mode-pill { font-size: 11px; padding: 3px 10px; border-radius: 999px; background: rgba(110,168,255,0.12); color: var(--accent); border: 1px solid rgba(110,168,255,0.3); }
  .mode-pill.live { background: rgba(248,113,113,0.12); color: var(--err); border-color: rgba(248,113,113,0.3); }
  .btn { background: var(--panel-2); color: var(--text); border: 1px solid var(--border); padding: 6px 12px; border-radius: 6px; cursor: pointer; font-size: 12px; }
  .btn:hover { background: #232a3a; }
  .btn.primary { background: var(--accent); color: #0b0e14; border-color: var(--accent); font-weight: 600; }
  .btn.primary:hover { filter: brightness(1.05); }
  .btn.danger { background: transparent; border-color: rgba(248,113,113,0.4); color: #fca5a5; }

  .layout { display: grid; grid-template-columns: 320px 6px 1fr; height: calc(100vh - 48px); }
  .v-resize-handle { width: 6px; background: var(--border); cursor: col-resize; position: relative; transition: background 0.15s ease; }
  .v-resize-handle::after { content: ''; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); height: 40px; width: 2px; background: var(--text-dim); border-radius: 1px; opacity: 0.4; transition: opacity 0.15s; }
  .v-resize-handle:hover, .v-resize-handle.dragging { background: var(--accent); }
  .v-resize-handle:hover::after, .v-resize-handle.dragging::after { background: var(--bg); opacity: 0.8; }
  .sidebar { background: var(--panel); border-right: 1px solid var(--border); overflow-y: auto; }
  .sidebar-search { padding: 10px; border-bottom: 1px solid var(--border); position: sticky; top: 0; background: var(--panel); z-index: 2; }
  .sidebar-search input { width: 100%; background: var(--panel-2); border: 1px solid var(--border); color: var(--text); padding: 7px 10px; border-radius: 6px; font-size: 12px; }
  .tag-group { border-bottom: 1px solid var(--border); }
  .tag-group h4 { margin: 0; padding: 10px 14px; font-size: 11px; text-transform: uppercase; letter-spacing: 0.8px; color: var(--text-dim); cursor: pointer; user-select: none; display: flex; align-items: center; justify-content: space-between; }
  .tag-group h4:hover { color: var(--text); }
  .op-list { padding-bottom: 6px; }
  .op-list.collapsed { display: none; }
  .op-row { padding: 6px 14px 6px 22px; display: flex; align-items: center; gap: 8px; cursor: pointer; border-left: 2px solid transparent; }
  .op-row:hover { background: var(--panel-2); }
  .op-row.active { background: #1f2738; border-left-color: var(--accent); }
  .op-method { font-weight: 700; font-size: 10px; min-width: 46px; text-align: center; padding: 2px 4px; border-radius: 3px; letter-spacing: 0.5px; }
  .m-get { color: var(--get); background: rgba(45,212,191,0.1); }
  .m-post { color: var(--post); background: rgba(250,204,21,0.1); }
  .m-put { color: var(--put); background: rgba(167,139,250,0.12); }
  .m-patch { color: var(--patch); background: rgba(251,146,60,0.12); }
  .m-delete { color: var(--delete); background: rgba(248,113,113,0.12); }
  .op-path { font-family: "SF Mono", Menlo, Consolas, monospace; font-size: 11.5px; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .workspace { display: flex; flex-direction: column; overflow: hidden; }
  .request-bar { padding: 14px 18px; background: var(--panel); border-bottom: 1px solid var(--border); display: flex; gap: 10px; align-items: center; }
  .method-badge { font-weight: 700; padding: 6px 12px; border-radius: 5px; font-size: 12px; min-width: 70px; text-align: center; }
  .url-box { flex: 1; background: var(--panel-2); border: 1px solid var(--border); padding: 8px 12px; border-radius: 5px; font-family: "SF Mono", Menlo, Consolas, monospace; font-size: 13px; color: var(--text); }
  .send-btn { padding: 9px 22px; }

  .op-summary { padding: 10px 18px 0 18px; color: var(--text-dim); font-size: 12px; }
  .op-summary strong { color: var(--text); }

  .tabs { display: flex; padding: 10px 18px 0 18px; border-bottom: 1px solid var(--border); gap: 18px; }
  .tab { background: none; border: none; color: var(--text-dim); padding: 8px 2px; cursor: pointer; font-size: 12px; border-bottom: 2px solid transparent; }
  .tab.active { color: var(--text); border-bottom-color: var(--accent); }
  .tab .count { color: var(--accent); margin-left: 4px; font-weight: 600; }

  .tab-panel { padding: 14px 18px; flex: 1; overflow-y: auto; min-height: 60px; }
  .resize-handle { height: 6px; background: var(--border); cursor: row-resize; flex-shrink: 0; position: relative; transition: background 0.15s ease; }
  .resize-handle::after { content: ''; position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 40px; height: 2px; background: var(--text-dim); border-radius: 1px; opacity: 0.4; transition: opacity 0.15s; }
  .resize-handle:hover, .resize-handle.dragging { background: var(--accent); }
  .resize-handle:hover::after, .resize-handle.dragging::after { background: var(--bg); opacity: 0.8; }
  .tab-panel.hidden { display: none; }

  .param-row { display: grid; grid-template-columns: 200px 1fr 200px; gap: 10px; padding: 6px 0; align-items: center; }
  .param-row label { font-family: "SF Mono", Menlo, Consolas, monospace; font-size: 12px; color: var(--text); }
  .param-row label .req { color: var(--err); margin-left: 3px; }
  .param-row input, .param-row select { background: var(--panel-2); border: 1px solid var(--border); color: var(--text); padding: 6px 10px; border-radius: 4px; font-size: 12px; width: 100%; font-family: "SF Mono", Menlo, Consolas, monospace; }
  .param-row .hint { color: var(--text-dim); font-size: 11px; }
  .params-empty { color: var(--text-dim); font-style: italic; padding: 4px 0; }

  .body-toolbar { display: flex; gap: 8px; margin-bottom: 8px; align-items: center; }
  .body-toolbar .body-info { color: var(--text-dim); font-size: 11px; margin-left: auto; }
  textarea#reqBody { width: 100%; min-height: 220px; background: var(--code-bg); border: 1px solid var(--border); color: var(--text); padding: 12px; border-radius: 5px; font-family: "SF Mono", Menlo, Consolas, monospace; font-size: 12.5px; resize: vertical; }

  .docs-pane { color: var(--text); }
  .docs-pane h3 { font-size: 14px; margin: 0 0 8px 0; }
  .docs-pane code { font-family: "SF Mono", Menlo, Consolas, monospace; font-size: 12px; background: var(--code-bg); padding: 1px 6px; border-radius: 3px; color: var(--accent-2); }
  .docs-pane table { width: 100%; border-collapse: collapse; font-size: 12px; margin: 8px 0 14px; }
  .docs-pane th, .docs-pane td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--border); }
  .docs-pane th { color: var(--text-dim); font-weight: 500; font-size: 11px; text-transform: uppercase; letter-spacing: 0.6px; }

  .response-pane { border-top: 1px solid var(--border); background: var(--panel); flex: 1; display: flex; flex-direction: column; min-height: 280px; overflow: hidden; }
  .response-meta { padding: 10px 18px; display: flex; gap: 14px; align-items: center; border-bottom: 1px solid var(--border); }
  .status-badge { font-weight: 700; padding: 4px 10px; border-radius: 4px; font-size: 12px; }
  .s-2xx { background: rgba(34,197,94,0.15); color: var(--ok); }
  .s-4xx { background: rgba(239,68,68,0.15); color: var(--err); }
  .s-5xx { background: rgba(239,68,68,0.25); color: #fca5a5; }
  .s-idle { background: var(--panel-2); color: var(--text-dim); }
  .response-meta .stat { color: var(--text-dim); font-size: 11.5px; }
  .response-tabs { display: flex; padding: 8px 18px 0; gap: 18px; border-bottom: 1px solid var(--border); }
  .rtab { background: none; border: none; color: var(--text-dim); padding: 6px 0; cursor: pointer; font-size: 11.5px; border-bottom: 2px solid transparent; }
  .rtab.active { color: var(--text); border-bottom-color: var(--accent-2); }
  pre.resp { margin: 0; padding: 14px 18px; flex: 1; overflow: auto; font-family: "SF Mono", Menlo, Consolas, monospace; font-size: 12.5px; line-height: 1.55; background: var(--code-bg); color: var(--text); }
  pre.resp.hidden { display: none; }

  /* JSON syntax */
  .j-key { color: #93c5fd; }
  .j-str { color: #86efac; }
  .j-num { color: #fbbf24; }
  .j-bool { color: #f472b6; }
  .j-null { color: #94a3b8; font-style: italic; }
  .j-copyable { cursor: pointer; border-bottom: 1px dashed currentColor; }
  .j-copyable:hover { background: rgba(110,168,255,0.18); border-radius: 2px; }
  .url-box:focus { outline: 1px solid var(--accent); outline-offset: -1px; }

  /* Scrollbar */
  ::-webkit-scrollbar { width: 9px; height: 9px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: #2a3243; border-radius: 4px; }
  ::-webkit-scrollbar-thumb:hover { background: #3a445a; }

  .toast { position: fixed; bottom: 20px; right: 20px; background: var(--panel-2); border: 1px solid var(--border); padding: 10px 16px; border-radius: 6px; box-shadow: 0 10px 24px rgba(0,0,0,0.4); animation: slidein 0.2s ease-out; z-index: 100; }
  @keyframes slidein { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
</style>
</head>
<body>
<div id="app">
  <header class="topbar">
    <div class="brand">Defect Tracker <span>· Mock API Playground</span></div>
    <div class="topbar-right">
      <span class="mode-pill" id="modePill" title="Click to toggle Mock / Live">Mock Mode</span>
      <button class="btn" id="resetBtn" title="Reset in-memory data to seed">Reset Data</button>
      <button class="btn danger" id="modeBtn" title="Toggle between mock and live backend">Switch to Live</button>
    </div>
  </header>
  <main class="layout">
    <aside class="sidebar">
      <div class="sidebar-search"><input id="search" placeholder="Filter endpoints (e.g. /defects, login)"></div>
      <div id="endpointList"></div>
    </aside>
    <div class="v-resize-handle" id="sidebarResize" title="Drag to resize sidebar · double-click to reset"></div>
    <section class="workspace">
      <div class="request-bar">
        <span class="method-badge m-get" id="reqMethod">GET</span>
        <input class="url-box" id="reqPath" type="text" value="/api/v1/auth/me" spellcheck="false" autocomplete="off">
        <button class="btn primary send-btn" id="sendBtn">Send</button>
      </div>
      <div class="op-summary" id="opSummary"></div>
      <div class="tabs">
        <button class="tab active" data-tab="params">Params <span class="count" id="cntParams"></span></button>
        <button class="tab" data-tab="headers">Headers</button>
        <button class="tab" data-tab="body">Body <span class="count" id="cntBody"></span></button>
        <button class="tab" data-tab="docs">Docs</button>
      </div>
      <div class="tab-panel" data-tab="params" id="panelParams"></div>
      <div class="tab-panel hidden" data-tab="headers" id="panelHeaders"></div>
      <div class="tab-panel hidden" data-tab="body" id="panelBody">
        <div class="body-toolbar">
          <button class="btn" id="loadExampleBtn">Load Example</button>
          <button class="btn" id="prettyBtn">Pretty Print</button>
          <span class="body-info" id="bodyInfo">JSON</span>
        </div>
        <textarea id="reqBody" placeholder="{ }"></textarea>
      </div>
      <div class="tab-panel hidden" data-tab="docs" id="panelDocs"></div>

      <div class="resize-handle" id="responseResize" title="Drag to resize response area"></div>
      <div class="response-pane" id="responsePane">
        <div class="response-meta">
          <span class="status-badge s-idle" id="respStatus">Send a request</span>
          <span class="stat" id="respTime"></span>
          <span class="stat" id="respSize"></span>
        </div>
        <div class="response-tabs">
          <button class="rtab active" data-rtab="body">Body</button>
          <button class="rtab" data-rtab="headers">Response Headers</button>
        </div>
        <pre class="resp" id="respBody">No request sent yet. Pick an endpoint, then click Send.</pre>
        <pre class="resp hidden" id="respHeaders"></pre>
      </div>
    </section>
  </main>
</div>

<script>
/* =========================================================================
 * DEFECT TRACKER MOCK PLAYGROUND
 * Architecture:
 *   ┌─────────────────────────────────────────────────────────────────┐
 *   │  UI (sidebar + request builder + response viewer)               │
 *   ├─────────────────────────────────────────────────────────────────┤
 *   │  apiClient.call(operationId, { path, query, headers, body })    │
 *   ├─────────────────────────────────────────────────────────────────┤
 *   │  DataProvider (interface)                                       │
 *   │    ├── MockProvider  (in-memory, seeded from schema/seed.sql)   │
 *   │    └── HttpProvider  (real backend - stub, drop-in tomorrow)    │
 *   └─────────────────────────────────────────────────────────────────┘
 *
 * To wire to a real backend tomorrow:
 *   1) Set CONFIG.useMock = false
 *   2) Set CONFIG.baseUrl  = 'https://your-api.example.com/api/v1'
 *   3) Set CONFIG.bearerToken = '...'
 *   No UI or operations metadata changes needed.
 * ========================================================================= */

const CONFIG = {
  useMock: true,
  baseUrl: '/api/v1',
  bearerToken: 'mock-jwt-token-for-demo'
};

/* ----------------------------- SEED DATA -------------------------------- */
/* Mirrors schema.sql + seed.sql exactly. Acts as the deterministic source
 * of truth for every read; mutations happen in-memory only (per session). */
const SEED_FACTORY = () => ({
  users: [
    { id: '10000000-0000-0000-0000-000000000001', name: 'QA User',     email: 'qa.user@example.com',     username: 'qa.user',     isActive: true, defaultDataContext: 'Test', lastLoginAt: '2026-05-13T08:30:00Z', createdAt: '2026-01-01T00:00:00Z', updatedAt: '2026-05-13T08:30:00Z' },
    { id: '10000000-0000-0000-0000-000000000002', name: 'Aisha Khan',  email: 'aisha.khan@example.com',  username: 'aisha.khan',  isActive: true, defaultDataContext: 'Test', lastLoginAt: '2026-05-12T11:10:00Z', createdAt: '2026-01-02T00:00:00Z', updatedAt: '2026-05-12T11:10:00Z' },
    { id: '10000000-0000-0000-0000-000000000003', name: 'Omar Farooq', email: 'omar.farooq@example.com', username: 'omar.farooq', isActive: true, defaultDataContext: 'Prod', lastLoginAt: '2026-05-10T17:22:00Z', createdAt: '2026-01-03T00:00:00Z', updatedAt: '2026-05-10T17:22:00Z' },
    { id: '10000000-0000-0000-0000-000000000004', name: 'Sara Mathew', email: 'sara.mathew@example.com', username: 'sara.mathew', isActive: true, defaultDataContext: 'All',  lastLoginAt: '2026-05-13T09:00:00Z', createdAt: '2026-01-04T00:00:00Z', updatedAt: '2026-05-13T09:00:00Z' }
  ],
  projects: [
    { id: '20000000-0000-0000-0000-000000000001', projectName: 'Claims Portal', description: 'Customer claim intake and processing workflow.',     isActive: true,  createdAt: '2026-01-05T00:00:00Z', updatedAt: '2026-01-05T00:00:00Z' },
    { id: '20000000-0000-0000-0000-000000000002', projectName: 'Billing Core',  description: 'Invoice, tax, and payment calculation services.',    isActive: true,  createdAt: '2026-01-05T00:00:00Z', updatedAt: '2026-01-05T00:00:00Z' },
    { id: '20000000-0000-0000-0000-000000000003', projectName: 'Mobile QA',     description: 'Mobile application regression and release testing.', isActive: true,  createdAt: '2026-01-05T00:00:00Z', updatedAt: '2026-01-05T00:00:00Z' },
    { id: '20000000-0000-0000-0000-000000000004', projectName: 'Legacy CRM',    description: 'Legacy support and controlled maintenance.',         isActive: false, createdAt: '2026-01-05T00:00:00Z', updatedAt: '2026-01-05T00:00:00Z' }
  ],
  environments: [
    { id: '30000000-0000-0000-0000-000000000001', environmentName: 'DEV',      environmentScope: 'Test', description: 'Development validation environment.',     isActive: true, sortOrder: 1 },
    { id: '30000000-0000-0000-0000-000000000002', environmentName: 'SIT',      environmentScope: 'Test', description: 'System integration testing environment.', isActive: true, sortOrder: 2 },
    { id: '30000000-0000-0000-0000-000000000003', environmentName: 'UAT',      environmentScope: 'Test', description: 'User acceptance testing environment.',    isActive: true, sortOrder: 3 },
    { id: '30000000-0000-0000-0000-000000000004', environmentName: 'Pre-Prod', environmentScope: 'Test', description: 'Pre-production verification environment.',isActive: true, sortOrder: 4 },
    { id: '30000000-0000-0000-0000-000000000005', environmentName: 'PROD',     environmentScope: 'Prod', description: 'Production environment.',                 isActive: true, sortOrder: 5 }
  ],
  releases: [
    { id: '40000000-0000-0000-0000-000000000001', projectId: '20000000-0000-0000-0000-000000000002', releaseVersion: '2026.04',        plannedDeploymentDate: '2026-04-20', actualDeploymentDate: '2026-04-21', isActive: true },
    { id: '40000000-0000-0000-0000-000000000002', projectId: '20000000-0000-0000-0000-000000000001', releaseVersion: '2026.05',        plannedDeploymentDate: '2026-05-18', actualDeploymentDate: null,         isActive: true },
    { id: '40000000-0000-0000-0000-000000000003', projectId: '20000000-0000-0000-0000-000000000003', releaseVersion: '2026.05-mobile', plannedDeploymentDate: '2026-05-25', actualDeploymentDate: null,         isActive: true }
  ],
  severityLevels: [
    { id: 1, name: 'Low',      rank: 1, colorToken: '--severity-low',      isActive: true },
    { id: 2, name: 'Medium',   rank: 2, colorToken: '--severity-medium',   isActive: true },
    { id: 3, name: 'High',     rank: 3, colorToken: '--severity-high',     isActive: true },
    { id: 4, name: 'Critical', rank: 4, colorToken: '--severity-critical', isActive: true }
  ],
  priorityLevels: [
    { id: 1, name: 'P4', rank: 1, isActive: true },
    { id: 2, name: 'P3', rank: 2, isActive: true },
    { id: 3, name: 'P2', rank: 3, isActive: true },
    { id: 4, name: 'P1', rank: 4, isActive: true }
  ],
  workflow: {
    id: '50000000-0000-0000-0000-000000000001',
    workflowName: 'Default Workflow',
    versionNo: 1,
    isActive: true,
    diagram: {
      nodes: [
        { id: 'node_assigned',   type: 'process', label: 'Assigned',   position: { x: 160,  y: 260 } },
        { id: 'node_inprogress', type: 'process', label: 'InProgress', position: { x: 420,  y: 260 } },
        { id: 'node_fixed',      type: 'process', label: 'Fixed',      position: { x: 700,  y: 260 } },
        { id: 'node_test',       type: 'process', label: 'Test',       position: { x: 960,  y: 260 } },
        { id: 'node_closed',     type: 'process', label: 'Closed',     position: { x: 1220, y: 260 } },
        { id: 'node_rejected',   type: 'process', label: 'Rejected',   position: { x: 420,  y: 90  } }
      ],
      edges: [
        { id: 'edge_1', source: 'node_assigned',   target: 'node_inprogress' },
        { id: 'edge_2', source: 'node_inprogress', target: 'node_fixed'      },
        { id: 'edge_3', source: 'node_inprogress', target: 'node_rejected'   },
        { id: 'edge_4', source: 'node_fixed',      target: 'node_test'       },
        { id: 'edge_5', source: 'node_test',       target: 'node_closed'     },
        { id: 'edge_6', source: 'node_test',       target: 'node_inprogress' }
      ],
      viewport: { x: 0, y: 0, zoom: 1 }
    },
    transitions: [
      { id: '51000000-0000-0000-0000-000000000001', fromStatus: 'Assigned',   toStatus: 'InProgress', displayOrder: 1, isActive: true },
      { id: '51000000-0000-0000-0000-000000000002', fromStatus: 'InProgress', toStatus: 'Fixed',      displayOrder: 1, isActive: true },
      { id: '51000000-0000-0000-0000-000000000003', fromStatus: 'InProgress', toStatus: 'Rejected',   displayOrder: 2, isActive: true },
      { id: '51000000-0000-0000-0000-000000000004', fromStatus: 'Fixed',      toStatus: 'Test',       displayOrder: 1, isActive: true },
      { id: '51000000-0000-0000-0000-000000000005', fromStatus: 'Test',       toStatus: 'Closed',     displayOrder: 1, isActive: true },
      { id: '51000000-0000-0000-0000-000000000006', fromStatus: 'Test',       toStatus: 'InProgress', displayOrder: 2, isActive: true }
    ]
  },
  defects: [
    { id: '60000000-0000-0000-0000-000000000001', defectKey: 'DF-1042', title: 'Invoice total mismatch after tax recalculation', description: 'The invoice total changes after refreshing the payment review screen in UAT.', projectId: '20000000-0000-0000-0000-000000000002', moduleComponent: 'Invoice Review',  environmentId: '30000000-0000-0000-0000-000000000003', severityId: 3, priorityId: 4, currentStatus: 'InProgress', assignedToUserId: '10000000-0000-0000-0000-000000000002', createdByUserId: '10000000-0000-0000-0000-000000000001', stepsHtml: '<ol><li>Open invoice review in UAT</li><li>Recalculate tax</li><li>Refresh the payment review screen</li></ol>', expectedResult: 'Invoice total remains unchanged after recalculation.', actualResult: 'Invoice total changes after refresh.', fixedInReleaseId: null,                                          fixDate: null,         closureDate: null,         createdAt: '2026-05-09T08:00:00Z', updatedAt: '2026-05-13T10:00:00Z', version: 1, isDeleted: false },
    { id: '60000000-0000-0000-0000-000000000002', defectKey: 'DF-1043', title: 'Claim attachment preview fails for PDF',          description: 'PDF attachment preview does not render in the claims evidence panel.',           projectId: '20000000-0000-0000-0000-000000000001', moduleComponent: 'Evidence Upload', environmentId: '30000000-0000-0000-0000-000000000002', severityId: 2, priorityId: 3, currentStatus: 'Assigned',   assignedToUserId: '10000000-0000-0000-0000-000000000003', createdByUserId: '10000000-0000-0000-0000-000000000001', stepsHtml: '<p>Upload a PDF in SIT and open preview.</p>',                                                                  expectedResult: 'PDF preview opens inside the evidence panel.',     actualResult: 'Preview area stays blank.',          fixedInReleaseId: null,                                          fixDate: null,         closureDate: null,         createdAt: '2026-05-10T08:00:00Z', updatedAt: '2026-05-10T08:00:00Z', version: 1, isDeleted: false },
