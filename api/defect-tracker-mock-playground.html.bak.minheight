      }
      case 'addDefectComment': {
        { const err = V.body(B, SCHEMAS.commentCreate); if (err) return this._err(400, 'validation_error', err); }
        const d = findById(db.defects, P.defectId);
        if (!d) return this._err(404, 'not_found', 'Defect not found');
        if (B.commentText.trim().length === 0) return this._err(400, 'validation_error', 'commentText must not be only whitespace');
        const c = { id: uuid(), defectId: d.id, commentText: B.commentText, createdByUserId: db.users[0].id, createdAt: nowIso(), updatedAt: null, isDeleted: false };
        db.comments.push(c);
