        const d = findById(db.defects, P.defectId);
        if (!d || d.isDeleted) return this._err(404, 'not_found', 'Defect not found');
        if (H['If-Match']) {
          const currentEtag = `W/"${d.version || 1}"`;
          if (H['If-Match'] !== currentEtag) return this._err(412, 'precondition_failed', `If-Match mismatch. Current: ${currentEtag}, supplied: ${H['If-Match']}. Reload and retry.`);
        }
        const batch = uuid();
        const fieldsToHistory = {
          currentStatus: 'status_changed', assignedToUserId: 'assignment_changed',
          severityId: 'severity_changed', priorityId: 'priority_changed', fixedInReleaseId: 'release_updated'
        };
        Object.keys(B).forEach(k => {
          if (B[k] === undefined) return;
          const oldV = d[k];
          if (oldV !== B[k]) {
            d[k] = B[k];
            const evtType = fieldsToHistory[k] || 'field_updated';
            db.historyEvents.push({ id: uuid(), defectId: d.id, eventBatchId: batch, eventType: evtType, fieldName: k, oldValue: oldV == null ? null : String(oldV), newValue: B[k] == null ? null : String(B[k]), metadata: {}, actorUserId: db.users[0].id, createdAt: nowIso() });
          }
        });
        d.updatedAt = nowIso();
        d.version = (d.version || 1) + 1;
        return this._ok(this._defectDetail(d));
