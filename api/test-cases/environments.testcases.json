      ],
      "requestMessage": {
        "method": "POST",
        "path": "/api/v1/environments",
        "headers": {
          "Authorization": "Bearer {{global.accessToken}}"
        },
        "query": {},
        "body": {
          "description": "API test environment.",
          "isActive": true,
          "sortOrder": 20
        }
      },
      "expectedResponse": {
        "statusCode": 400,
        "checks": [
          "Response indicates validation error."
        ]
      },
      "dbExpectation": []
    },
    {
      "caseId": "ENV-API-009",
      "title": "Update environments succeeds",
      "description": "Verify environments can be updated.",
      "severity": "High",
      "precondition": [
        "User is authenticated.",
        "A disposable environments record exists."
      ],
      "requestMessage": {
        "method": "PATCH",
        "path": "/api/v1/environments/{{createdEnvironmentId}}",
        "headers": {
          "Authorization": "Bearer {{global.accessToken}}"
        },
        "query": {},
        "body": {
          "environmentName": "QA-SANDBOX-UPDATED-{{global.runId}}",
          "description": "Updated.",
          "isActive": false,
          "sortOrder": 21
        }
      },
      "expectedResponse": {
        "statusCode": 200,
        "checks": [
          "Response environmentName or status matches request."
        ]
      },
      "dbExpectation": [
        "environments record is updated."
      ]
    },
    {
      "caseId": "ENV-API-010",
      "title": "Update environments rejects duplicate name",
      "description": "Verify environments update prevents duplicate name.",
      "severity": "High",
      "precondition": [
        "User is authenticated.",
        "A disposable environments record exists."
      ],
      "requestMessage": {
        "method": "PATCH",
        "path": "/api/v1/environments/{{createdEnvironmentId}}",
        "headers": {
          "Authorization": "Bearer {{global.accessToken}}"
        },
        "query": {},
        "body": {
          "environmentName": "UAT"
        }
      },
      "expectedResponse": {
        "statusCode": 400,
        "checks": [
          "Response indicates name already exists."
        ]
      },
      "dbExpectation": [
        "environments record remains unchanged."
      ]
    },
    {
      "caseId": "ENV-API-011",
      "title": "Update environments not found",
      "description": "Verify updating a missing environments returns not found.",
      "severity": "Medium",
      "precondition": [
        "User is authenticated."
      ],
      "requestMessage": {
        "method": "PATCH",
        "path": "/api/v1/environments/{{missingEnvironmentId}}",
        "headers": {
          "Authorization": "Bearer {{global.accessToken}}"
        },
        "query": {},
        "body": {
          "environmentName": "QA-SANDBOX-UPDATED-{{global.runId}}",
          "description": "Updated.",
          "isActive": false,
          "sortOrder": 21
        }
      },
      "expectedResponse": {
        "statusCode": 404,
        "checks": [
          "Response indicates environments not found."
        ]
      },
      "dbExpectation": []
    }
