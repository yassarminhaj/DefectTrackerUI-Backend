{
  "module": "History",
  "basePath": "/api/v1",
  "testCases": [
    {
      "caseId": "HISTORY-API-001",
      "title": "List defect history succeeds",
      "description": "Verify defect history timeline is returned.",
      "severity": "High",
      "precondition": [
        "User is authenticated.",
        "A defect exists with history events."
      ],
      "requestMessage": {
        "method": "GET",
        "path": "/api/v1/defects/{{createdDefectId}}/history",
        "headers": {
          "Authorization": "Bearer {{global.accessToken}}"
        },
        "query": {},
        "body": {}
      },
      "expectedResponse": {
        "statusCode": 200,
        "checks": [
          "Response contains items array.",
          "History items contain eventType and createdAt."
        ]
      },
      "dbExpectation": []
    },
    {
      "caseId": "HISTORY-API-002",
      "title": "History shows defect creation event",
      "description": "Verify created defect has defect_created history event.",
      "severity": "High",
      "precondition": [
        "User is authenticated.",
        "A defect was created by API."
      ],
      "requestMessage": {
        "method": "GET",
        "path": "/api/v1/defects/{{createdDefectId}}/history",
        "headers": {
          "Authorization": "Bearer {{global.accessToken}}"
        },
        "query": {},
        "body": {}
      },
      "expectedResponse": {
        "statusCode": 200,
        "checks": [
          "At least one item has eventType defect_created."
        ]
      },
      "dbExpectation": []
    },
    {
      "caseId": "HISTORY-API-003",
      "title": "History shows status change event",
      "description": "Verify status update writes history event.",
      "severity": "High",
      "precondition": [
        "User is authenticated.",
        "A defect status was updated."
      ],
      "requestMessage": {
        "method": "GET",
        "path": "/api/v1/defects/{{createdDefectId}}/history",
        "headers": {
          "Authorization": "Bearer {{global.accessToken}}"
        },
        "query": {},
        "body": {}
      },
      "expectedResponse": {
        "statusCode": 200,
        "checks": [
          "At least one item has eventType status_changed."
        ]
      },
      "dbExpectation": []
    },
    {
      "caseId": "HISTORY-API-004",
      "title": "History invalid defect returns not found",
      "description": "Verify missing defect history request is rejected cleanly.",
      "severity": "Medium",
      "precondition": [
        "User is authenticated."
      ],
      "requestMessage": {
        "method": "GET",
        "path": "/api/v1/defects/{{missingDefectId}}/history",
        "headers": {
          "Authorization": "Bearer {{global.accessToken}}"
        },
        "query": {},
        "body": {}
      },
      "expectedResponse": {
        "statusCode": 404,
        "checks": [
          "Response indicates defect not found."
        ]
      },
      "dbExpectation": []
    },
    {
      "caseId": "HISTORY-API-005",
      "title": "History requires bearer token",
      "description": "Verify history read is protected by bearer authentication.",
      "severity": "Critical",
      "precondition": [
        "A defect exists."
      ],
      "requestMessage": {
        "method": "GET",
        "path": "/api/v1/defects/{{createdDefectId}}/history",
        "headers": {},
        "query": {},
        "body": {}
      },
      "expectedResponse": {
        "statusCode": 401,
        "checks": [
          "Response error.code is unauthorized."
        ]
      },
      "dbExpectation": []
    }
  ]
}