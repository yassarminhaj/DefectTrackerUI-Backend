{
  "module": "Auth",
  "basePath": "/api/v1",
  "testCases": [
    {
      "caseId": "AUTH-API-001",
      "title": "Login succeeds with valid user",
      "description": "Verify valid credentials return a bearer token and user profile context.",
      "severity": "Critical",
      "precondition": [
        "Seeded active user credentials are available."
      ],
      "requestMessage": {
        "method": "POST",
        "path": "/api/v1/auth/login",
        "headers": {},
        "query": {},
        "body": {
          "username": "{{secrets.testUsername}}",
          "password": "{{secrets.testPassword}}",
          "dataContext": "Test"
        }
      },
      "expectedResponse": {
        "statusCode": 200,
        "checks": [
          "Response contains accessToken.",
          "Response contains refreshToken.",
          "Response user.username matches request.",
          "activeDataContext is Test."
        ]
      },
      "dbExpectation": []
    },
    {
      "caseId": "AUTH-API-002",
      "title": "Login rejects missing username",
      "description": "Verify login fails when username is absent in the current live API.",
      "severity": "High",
      "precondition": [],
      "requestMessage": {
        "method": "POST",
        "path": "/api/v1/auth/login",
        "headers": {},
        "query": {},
        "body": {
          "password": "{{secrets.testPassword}}"
        }
      },
      "expectedResponse": {
        "statusCode": 401,
        "checks": [
          "Response error.code is invalid_credentials.",
          "No token is returned."
        ]
      },
      "dbExpectation": []
    },
    {
      "caseId": "AUTH-API-003",
      "title": "Login rejects missing password",
      "description": "Verify login requires a password for an active username.",
      "severity": "Critical",
      "precondition": [],
      "requestMessage": {
        "method": "POST",
        "path": "/api/v1/auth/login",
        "headers": {},
        "query": {},
        "body": {
          "username": "{{secrets.testUsername}}"
        }
      },
      "expectedResponse": {
        "statusCode": 401,
        "checks": [
          "Response error.code is invalid_credentials.",
          "No token is returned."
        ]
      },
      "dbExpectation": []
    },
    {
      "caseId": "AUTH-API-004",
      "title": "Login rejects wrong password",
      "description": "Verify login validates the password for an active username.",
      "severity": "Critical",
      "precondition": [],
      "requestMessage": {
        "method": "POST",
        "path": "/api/v1/auth/login",
        "headers": {},
        "query": {},
        "body": {
          "username": "{{secrets.testUsername}}",
          "password": "wrong-password"
        }
      },
      "expectedResponse": {
        "statusCode": 401,
        "checks": [
          "Response error.code is invalid_credentials.",
          "No token is returned."
        ]
      },
      "dbExpectation": []
    },
    {
      "caseId": "AUTH-API-005",
      "title": "Refresh token succeeds",
      "description": "Verify refresh endpoint returns a new access token for a valid refresh token.",
      "severity": "High",
      "precondition": [
        "A valid refresh token is available from login."
      ],
      "requestMessage": {
        "method": "POST",
        "path": "/api/v1/auth/refresh",
        "headers": {},
        "query": {},
        "body": {
          "refreshToken": "{{global.refreshToken}}"
        }
      },
      "expectedResponse": {
        "statusCode": 200,
        "checks": [
          "Response contains accessToken.",
          "Response contains refreshToken."
        ]
      },
      "dbExpectation": []
    },
    {
      "caseId": "AUTH-API-006",
      "title": "Refresh token rejects empty token",
      "description": "Verify refresh endpoint rejects requests without a refresh token.",
      "severity": "High",
      "precondition": [],
      "requestMessage": {
        "method": "POST",
        "path": "/api/v1/auth/refresh",
        "headers": {},
        "query": {},
        "body": {}
      },
      "expectedResponse": {
        "statusCode": 401,
        "checks": [
          "Response error.code is invalid_refresh_token.",
          "No token is returned."
        ]
      },
      "dbExpectation": []
    },
    {
      "caseId": "AUTH-API-007",
      "title": "Current user succeeds",
      "description": "Verify authenticated user profile can be read.",
      "severity": "High",
      "precondition": [
        "User is authenticated."
      ],
      "requestMessage": {
        "method": "GET",
        "path": "/api/v1/auth/me",
        "headers": {
          "Authorization": "Bearer {{global.accessToken}}"
        },
        "query": {},
        "body": {}
      },
      "expectedResponse": {
        "statusCode": 200,
        "checks": [
          "Response contains user id.",
          "Response contains availableDataContexts."
        ]
      },
      "dbExpectation": []
    },
    {
      "caseId": "AUTH-API-008",
      "title": "Current user without token is rejected",
      "description": "Verify current user endpoint requires a bearer token.",
      "severity": "Critical",
      "precondition": [],
      "requestMessage": {
        "method": "GET",
        "path": "/api/v1/auth/me",
        "headers": {},
        "query": {},
        "body": {}
      },
      "expectedResponse": {
        "statusCode": 401,
        "checks": [
          "Response error.code is unauthorized.",
          "No user profile is returned."
        ]
      },
      "dbExpectation": []
    },
    {
      "caseId": "AUTH-API-009",
      "title": "Update own profile succeeds",
      "description": "Verify user can update own email profile field.",
      "severity": "Medium",
      "precondition": [
        "User is authenticated."
      ],
      "requestMessage": {
        "method": "PATCH",
        "path": "/api/v1/auth/profile",
        "headers": {
          "Authorization": "Bearer {{global.accessToken}}"
        },
        "query": {},
        "body": {
          "email": "qa.profile.{{global.runId}}@example.com"
        }
      },
      "expectedResponse": {
        "statusCode": 200,
        "checks": [
          "Response email matches request."
        ]
      },
      "dbExpectation": [
        "app_users current user email is updated."
      ]
    },
    {
      "caseId": "AUTH-API-010",
      "title": "Update own profile currently accepts non-email string",
      "description": "Document current live behavior where profile email format is not yet validated.",
      "severity": "High",
      "precondition": [
        "User is authenticated."
      ],
      "requestMessage": {
        "method": "PATCH",
        "path": "/api/v1/auth/profile",
        "headers": {
          "Authorization": "Bearer {{global.accessToken}}"
        },
        "query": {},
        "body": {
          "email": "not-an-email-{{global.runId}}"
        }
      },
      "expectedResponse": {
        "statusCode": 200,
        "checks": [
          "Response email matches request value.",
          "This is a validation gap to harden later."
        ]
      },
      "dbExpectation": [
        "app_users current user email is updated per current behavior."
      ]
    },
    {
      "caseId": "AUTH-API-011",
      "title": "Change own password succeeds",
      "description": "Verify password change accepts previous, new, and confirm password.",
      "severity": "High",
      "precondition": [
        "User is authenticated."
      ],
      "requestMessage": {
        "method": "POST",
        "path": "/api/v1/auth/password",
        "headers": {
          "Authorization": "Bearer {{global.accessToken}}"
        },
        "query": {},
        "body": {
          "previousPassword": "{{secrets.testPassword}}",
          "newPassword": "Welcome1234",
          "confirmPassword": "Welcome1234"
        }
      },
      "expectedResponse": {
        "statusCode": 204,
        "checks": [
          "Empty response body is returned."
        ]
      },
      "dbExpectation": [
        "user_password_events self_change event is created."
      ]
    },
    {
      "caseId": "AUTH-API-012",
      "title": "Change own password rejects mismatched confirmation",
      "description": "Verify password change rejects different new and confirm values.",
      "severity": "High",
      "precondition": [
        "User is authenticated."
      ],
      "requestMessage": {
        "method": "POST",
        "path": "/api/v1/auth/password",
        "headers": {
          "Authorization": "Bearer {{global.accessToken}}"
        },
        "query": {},
        "body": {
          "previousPassword": "{{secrets.testPassword}}",
          "newPassword": "Welcome1234",
          "confirmPassword": "Welcome5678"
        }
      },
      "expectedResponse": {
        "statusCode": 400,
        "checks": [
          "Response indicates validation error."
        ]
      },
      "dbExpectation": [
        "Password is not changed."
      ]
    },
    {
      "caseId": "AUTH-API-013",
      "title": "Login without context uses user default",
      "description": "Verify login uses app_users.default_data_context when dataContext is omitted.",
      "severity": "High",
      "precondition": [
        "A seeded or disposable user exists with defaultDataContext set to Prod or All."
      ],
      "requestMessage": {
        "method": "POST",
        "path": "/api/v1/auth/login",
        "headers": {},
        "query": {},
        "body": {
          "username": "{{secrets.contextUsername}}",
          "password": "{{secrets.contextPassword}}"
        }
      },
      "expectedResponse": {
        "statusCode": 200,
        "checks": [
          "Response activeDataContext matches app_users.default_data_context.",
          "Response user.defaultDataContext matches app_users.default_data_context."
        ]
      },
      "dbExpectation": [
        "app_users.default_data_context is not modified by login."
      ]
    },
    {
      "caseId": "AUTH-API-014",
      "title": "Login context overrides user default for session",
      "description": "Verify explicit login dataContext overrides the saved user default for the returned session context.",
      "severity": "High",
      "precondition": [
        "A seeded or disposable user exists with defaultDataContext different from the requested dataContext."
      ],
      "requestMessage": {
        "method": "POST",
        "path": "/api/v1/auth/login",
        "headers": {},
        "query": {},
        "body": {
          "username": "{{secrets.contextUsername}}",
          "password": "{{secrets.contextPassword}}",
          "dataContext": "All"
        }
      },
      "expectedResponse": {
        "statusCode": 200,
        "checks": [
          "Response activeDataContext is All.",
          "Response user.defaultDataContext still matches app_users.default_data_context."
        ]
      },
      "dbExpectation": [
        "app_users.default_data_context is not modified by login override."
      ]
    }
  ]
}