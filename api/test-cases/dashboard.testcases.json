      "title": "Dashboard summary succeeds",
      "description": "Verify dashboard summary cards are returned.",
      "severity": "High",
      "precondition": [
        "User is authenticated."
      ],
      "requestMessage": {
        "method": "GET",
        "path": "/api/v1/dashboard/summary",
        "headers": {
          "Authorization": "Bearer {{global.accessToken}}",
          "X-Data-Context": "All"
        },
        "query": {},
        "body": {}
      },
      "expectedResponse": {
        "statusCode": 200,
        "checks": [
          "Response contains totalDefects.",
          "Response contains status and severity metrics."
        ]
      },
      "dbExpectation": []
