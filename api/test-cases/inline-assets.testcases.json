{
  "module": "Inline Assets",
  "basePath": "/api/v1",
  "testCases": [
    {
      "caseId": "INLINE-API-001",
      "title": "Upload inline asset succeeds",
      "description": "Verify inline Steps image content can be created with a matching stored file.",
      "severity": "High",
      "precondition": [
        "User is authenticated.",
        "A defect exists."
      ],
      "requestMessage": {
        "method": "POST",
        "path": "/api/v1/defects/{{createdDefectId}}/inline-assets",
        "headers": {
          "Authorization": "Bearer {{global.accessToken}}"
        },
        "query": {},
        "body": {
          "filename": "step-{{global.runId}}.png",
          "contentType": "image/png",
          "fileSizeBytes": 68,
          "widthPx": 800,
          "heightPx": 600,
          "contentDataUrl": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+/p9sAAAAASUVORK5CYII="
        }
      },
      "expectedResponse": {
        "statusCode": 201,
        "checks": [
          "Response contains id.",
          "Response contentUrl exists.",
          "Response widthPx is 800."
        ]
      },
      "dbExpectation": [
        "defect_inline_assets record is created.",
        "storage_key points to a physical file.",
        "inline_asset_added history event is created."
      ]
    },
    {
      "caseId": "INLINE-API-002",
      "title": "Upload inline asset rejects non-image content type",
      "description": "Verify inline assets are limited to pasted image content.",
      "severity": "High",
      "precondition": [
        "User is authenticated.",
        "A defect exists."
      ],
      "requestMessage": {
        "method": "POST",
        "path": "/api/v1/defects/{{createdDefectId}}/inline-assets",
        "headers": {
          "Authorization": "Bearer {{global.accessToken}}"
        },
        "query": {},
        "body": {
          "filename": "bad.txt",
          "contentType": "text/plain",
          "fileSizeBytes": 100,
          "widthPx": 100,
          "heightPx": 100,
          "contentDataUrl": "data:text/plain;base64,dGVzdA=="
        }
      },
      "expectedResponse": {
        "statusCode": 400,
        "checks": [
          "Response error.code is validation_error.",
          "Response states inline assets must be images."
        ]
      },
      "dbExpectation": [
        "No inline asset is created."
      ]
    },
    {
      "caseId": "INLINE-API-003",
      "title": "Upload inline asset rejects invalid defect",
      "description": "Verify invalid defect ID is handled.",
      "severity": "High",
      "precondition": [
        "User is authenticated."
      ],
      "requestMessage": {
        "method": "POST",
        "path": "/api/v1/defects/{{missingDefectId}}/inline-assets",
        "headers": {
          "Authorization": "Bearer {{global.accessToken}}"
        },
        "query": {},
        "body": {
          "filename": "step-{{global.runId}}.png",
          "contentType": "image/png",
          "fileSizeBytes": 68,
          "widthPx": 800,
          "heightPx": 600,
          "contentDataUrl": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+/p9sAAAAASUVORK5CYII="
        }
      },
      "expectedResponse": {
        "statusCode": 404,
        "checks": [
          "Response indicates defect not found."
        ]
      },
      "dbExpectation": []
    },
    {
      "caseId": "INLINE-API-004",
      "title": "Update inline asset dimensions succeeds",
      "description": "Verify asset display dimensions can be updated.",
      "severity": "Medium",
      "precondition": [
        "User is authenticated.",
        "An inline asset exists."
      ],
      "requestMessage": {
        "method": "PATCH",
        "path": "/api/v1/defects/{{createdDefectId}}/inline-assets/{{createdInlineAssetId}}",
        "headers": {
          "Authorization": "Bearer {{global.accessToken}}"
        },
        "query": {},
        "body": {
          "widthPx": 1024,
          "heightPx": 768
        }
      },
      "expectedResponse": {
        "statusCode": 200,
        "checks": [
          "Response widthPx is 1024.",
          "Response heightPx is 768."
        ]
      },
      "dbExpectation": [
        "defect_inline_assets dimensions are updated."
      ]
    },
    {
      "caseId": "INLINE-API-005",
      "title": "Update inline asset rejects zero width",
      "description": "Verify inline asset dimensions must be positive values.",
      "severity": "High",
      "precondition": [
        "User is authenticated.",
        "An inline asset exists."
      ],
      "requestMessage": {
        "method": "PATCH",
        "path": "/api/v1/defects/{{createdDefectId}}/inline-assets/{{createdInlineAssetId}}",
        "headers": {
          "Authorization": "Bearer {{global.accessToken}}"
        },
        "query": {},
        "body": {
          "widthPx": 0
        }
      },
      "expectedResponse": {
        "statusCode": 400,
        "checks": [
          "Response error.code is validation_error."
        ]
      },
      "dbExpectation": []
    },
    {
      "caseId": "INLINE-API-006",
      "title": "Delete inline asset succeeds",
      "description": "Verify inline asset delete is soft delete.",
      "severity": "High",
      "precondition": [
        "User is authenticated.",
        "An inline asset exists."
      ],
      "requestMessage": {
        "method": "DELETE",
        "path": "/api/v1/defects/{{createdDefectId}}/inline-assets/{{createdInlineAssetId}}",
        "headers": {
          "Authorization": "Bearer {{global.accessToken}}"
        },
        "query": {},
        "body": {}
      },
      "expectedResponse": {
        "statusCode": 204,
        "checks": [
          "Empty response body is returned."
        ]
      },
      "dbExpectation": [
        "defect_inline_assets is_deleted is true."
      ]
    },
    {
      "caseId": "INLINE-API-007",
      "title": "Delete inline asset not found",
      "description": "Verify missing inline asset returns not found.",
      "severity": "Medium",
      "precondition": [
        "User is authenticated.",
        "A defect exists."
      ],
      "requestMessage": {
        "method": "DELETE",
        "path": "/api/v1/defects/{{createdDefectId}}/inline-assets/{{missingInlineAssetId}}",
        "headers": {
          "Authorization": "Bearer {{global.accessToken}}"
        },
        "query": {},
        "body": {}
      },
      "expectedResponse": {
        "statusCode": 404,
        "checks": [
          "Response indicates inline asset not found."
        ]
      },
      "dbExpectation": []
    },
    {
      "caseId": "INLINE-API-008",
      "title": "Get inline asset content succeeds",
      "description": "Verify current API streams the stored inline image bytes.",
      "severity": "Medium",
      "precondition": [
        "User is authenticated.",
        "An inline asset exists.",
        "The inline storage_key points to a physical file."
      ],
      "requestMessage": {
        "method": "GET",
        "path": "/api/v1/defects/{{createdDefectId}}/inline-assets/{{createdInlineAssetId}}/content",
        "headers": {
          "Authorization": "Bearer {{global.accessToken}}"
        },
        "query": {},
        "body": {}
      },
      "expectedResponse": {
        "statusCode": 200,
        "checks": [
          "Response bytes match the uploaded image.",
          "Content-Type remains image/png or image/jpeg."
        ]
      },
      "dbExpectation": []
    },
    {
      "caseId": "INLINE-API-009",
      "title": "Inline asset upload requires bearer token",
      "description": "Verify inline asset upload is protected by bearer authentication.",
      "severity": "Critical",
      "precondition": [
        "A defect exists."
      ],
      "requestMessage": {
        "method": "POST",
        "path": "/api/v1/defects/{{createdDefectId}}/inline-assets",
        "headers": {},
        "query": {},
        "body": {
          "filename": "step.png",
          "contentType": "image/png",
          "fileSizeBytes": 100,
          "widthPx": 100,
          "heightPx": 100
        }
      },
      "expectedResponse": {
        "statusCode": 401,
        "checks": [
          "Response error.code is unauthorized."
        ]
      },
      "dbExpectation": []
    }
  ]
}