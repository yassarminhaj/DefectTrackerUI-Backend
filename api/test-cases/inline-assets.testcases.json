      ],
      "requestMessage": {
        "method": "POST",
        "path": "/api/v1/defects/{{createdDefectId}}/inline-assets",
        "headers": {},
        "query": {},
        "body": {
          "filename": "step.png",
          "contentType": "image/png",
          "fileSizeBytes": 100,
          "widthPx": 100,
          "heightPx": 100
        }
      },
      "expectedResponse": {
        "statusCode": 201,
        "checks": [
          "Response contains id.",
          "This is a known hardening gap before production auth."
        ]
      },
      "dbExpectation": []
    }
  ]
}