{
  "purpose": "Shared runtime setup for API test execution. Only true runtime globals live here.",
  "basePath": "/api/v1",
  "login": {
    "requestMessage": {
      "method": "POST",
      "path": "/api/v1/auth/login",
      "headers": {},
      "query": {},
      "body": {
        "username": "{{secrets.testUsername}}",
        "password": "{{secrets.testPassword}}",
        "dataContext": "All"
      }
    },
    "capture": {
      "accessToken": "$.accessToken",
      "refreshToken": "$.refreshToken",
      "loggedInUserId": "$.user.id",
      "loggedInUsername": "$.user.username",
      "activeDataContext": "$.activeDataContext"
    }
  },
  "runtimeVariables": {
    "runId": "Generated by framework for each run.",
    "accessToken": "Captured from login response.",
    "refreshToken": "Captured from login response.",
    "loggedInUserId": "Captured from login response."
  }
}