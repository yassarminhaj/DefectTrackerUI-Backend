{
  "module": "Defects",
  "basePath": "/api/v1",
  "testCases": [
    {
      "caseId": "DEFECT-API-001",
      "title": "List defects succeeds",
      "description": "Verify defect list returns paginated defects.",
      "severity": "High",
      "precondition": [
        "User is authenticated."
      ],
      "requestMessage": {
        "method": "GET",
        "path": "/api/v1/defects",
        "headers": {
          "Authorization": "Bearer {{global.accessToken}}"
        },
        "query": {
          "page": 1,
          "pageSize": 10
        },
        "body": {}
      },
      "expectedResponse": {
        "statusCode": 200,
        "checks": [
          "Response contains items array.",
          "Response contains pagination."
        ]
      },
      "dbExpectation": []
    },
    {
      "caseId": "DEFECT-API-002",
