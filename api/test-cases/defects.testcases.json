    {
      "caseId": "DEFECT-API-004",
      "title": "List defects filters by project",
      "description": "Verify projectId filter returns only selected project defects.",
      "severity": "Medium",
      "precondition": [
        "User is authenticated."
      ],
      "requestMessage": {
        "method": "GET",
        "path": "/api/v1/defects",
        "headers": {
          "Authorization": "Bearer {{global.accessToken}}"
        },
        "query": {
          "projectId": "{{data.projects.billingCore.id}}"
        },
        "body": {}
      },
      "expectedResponse": {
        "statusCode": 200,
        "checks": [
          "Every returned defect belongs to Billing Core."
        ]
      },
      "dbExpectation": []
    },
    {
      "caseId": "DEFECT-API-005",
      "title": "Create defect succeeds",
      "description": "Verify valid defect creation.",
      "severity": "Critical",
      "precondition": [
        "User is authenticated."
      ],
      "requestMessage": {
        "method": "POST",
        "path": "/api/v1/defects",
        "headers": {
          "Authorization": "Bearer {{global.accessToken}}"
        },
        "query": {
          "forceCreate": "true"
        },
        "body": {
          "title": "API defect {{global.runId}}",
          "description": "Created by API test.",
          "projectId": "{{data.projects.billingCore.id}}",
          "moduleComponent": "Invoice Review",
          "environmentId": "{{data.environments.uat.id}}",
          "severityId": "{{data.severities.high.id}}",
          "priorityId": "{{data.priorities.p1.id}}",
          "assignedToUserId": "{{data.users.aishaKhan.id}}",
          "stepsHtml": "<p>Open invoice review.</p>",
          "expectedResult": "Invoice total remains stable.",
          "actualResult": "Invoice total changes."
        }
      },
      "expectedResponse": {
        "statusCode": 201,
        "checks": [
          "Response contains id.",
          "Response contains defectKey.",
          "Response currentStatus is assigned by workflow."
        ]
      },
      "dbExpectation": [
        "defects record is created.",
        "defect_created history event is created."
      ]
    },
    {
      "caseId": "DEFECT-API-006",
      "title": "Create defect warns for duplicate same project title",
      "description": "Verify same normalized title in same project returns advisory warning.",
      "severity": "High",
      "precondition": [
        "User is authenticated.",
        "A baseline defect exists in Billing Core with matching title."
      ],
      "requestMessage": {
        "method": "POST",
        "path": "/api/v1/defects",
        "headers": {
          "Authorization": "Bearer {{global.accessToken}}"
        },
        "query": {
          "forceCreate": "false"
        },
        "body": {
          "title": "Duplicate billing defect {{global.runId}}",
          "description": "Created by API test.",
          "projectId": "{{data.projects.billingCore.id}}",
          "moduleComponent": "Different Module",
          "environmentId": "{{data.environments.prod.id}}",
          "severityId": "{{data.severities.high.id}}",
          "priorityId": "{{data.priorities.p1.id}}",
          "assignedToUserId": "{{data.users.aishaKhan.id}}",
          "stepsHtml": "<p>Open invoice review.</p>",
          "expectedResult": "Invoice total remains stable.",
          "actualResult": "Invoice total changes."
        }
      },
      "expectedResponse": {
        "statusCode": 409,
        "checks": [
          "Response error.code is possible_duplicate_defect.",
          "Response contains duplicateCandidates."
        ]
      },
      "dbExpectation": [
        "Second defect is not created."
      ]
    },
    {
      "caseId": "DEFECT-API-007",
      "title": "Create same title in different project succeeds",
      "description": "Verify duplicate warning is project-scoped only.",
      "severity": "Medium",
      "precondition": [
        "User is authenticated.",
        "A baseline defect exists in Billing Core with same title."
      ],
      "requestMessage": {
        "method": "POST",
        "path": "/api/v1/defects",
        "headers": {
          "Authorization": "Bearer {{global.accessToken}}"
        },
        "query": {
          "forceCreate": "false"
        },
        "body": {
          "title": "Cross project duplicate {{global.runId}}",
          "description": "Created by API test.",
          "projectId": "{{data.projects.claimsPortal.id}}",
          "moduleComponent": "Invoice Review",
          "environmentId": "{{data.environments.uat.id}}",
          "severityId": "{{data.severities.high.id}}",
          "priorityId": "{{data.priorities.p1.id}}",
          "assignedToUserId": "{{data.users.aishaKhan.id}}",
          "stepsHtml": "<p>Open invoice review.</p>",
          "expectedResult": "Invoice total remains stable.",
          "actualResult": "Invoice total changes."
        }
      },
      "expectedResponse": {
        "statusCode": 201,
        "checks": [
          "Response is created.",
          "No duplicate advisory is returned."
        ]
      },
      "dbExpectation": [
        "defects record is created in Claims Portal."
      ]
    },
