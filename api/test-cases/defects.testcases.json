    {
      "caseId": "DEFECT-API-012",
      "title": "Update defect valid status succeeds",
      "description": "Verify status can move through allowed workflow transition.",
      "severity": "Critical",
      "precondition": [
        "User is authenticated.",
        "A defect exists in Assigned status."
      ],
      "requestMessage": {
        "method": "PATCH",
        "path": "/api/v1/defects/{{createdDefectId}}",
        "headers": {
          "Authorization": "Bearer {{global.accessToken}}"
        },
        "query": {},
        "body": {
          "currentStatus": "InProgress"
        }
      },
      "expectedResponse": {
        "statusCode": 200,
        "checks": [
          "Response currentStatus is InProgress."
        ]
      },
      "dbExpectation": [
        "defects current_status is updated.",
        "status_changed history event is created."
      ]
    },
    {
      "caseId": "DEFECT-API-013",
      "title": "Update defect invalid status transition rejected",
      "description": "Verify workflow prevents invalid status jump.",
      "severity": "Critical",
      "precondition": [
        "User is authenticated.",
        "A defect exists in Assigned status."
      ],
      "requestMessage": {
        "method": "PATCH",
        "path": "/api/v1/defects/{{createdDefectId}}",
        "headers": {
          "Authorization": "Bearer {{global.accessToken}}"
        },
        "query": {},
        "body": {
          "currentStatus": "Fixed"
        }
      },
      "expectedResponse": {
        "statusCode": 400,
        "checks": [
          "Response error.code is invalid_status_transition."
        ]
      },
      "dbExpectation": [
        "Defect status remains unchanged."
      ]
    },
