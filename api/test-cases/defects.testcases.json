        "path": "/api/v1/defects",
        "headers": {
          "Authorization": "Bearer {{global.accessToken}}",
          "X-Data-Context": "Test"
        },
        "query": {},
        "body": {}
      },
      "expectedResponse": {
        "statusCode": 200,
        "checks": [
          "Returned defects belong to Test environments."
        ]
      },
      "dbExpectation": []
