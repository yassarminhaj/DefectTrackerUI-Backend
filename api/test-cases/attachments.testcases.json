{
  "module": "Attachments",
  "basePath": "/api/v1",
  "testCases": [
    {
      "caseId": "ATTACH-API-001",
      "title": "List attachments succeeds",
      "description": "Verify attachments can be listed for a defect.",
      "severity": "Medium",
      "precondition": [
        "User is authenticated.",
        "A defect exists."
      ],
      "requestMessage": {
        "method": "GET",
        "path": "/api/v1/defects/{{createdDefectId}}/attachments",
        "headers": {
          "Authorization": "Bearer {{global.accessToken}}"
        },
        "query": {},
        "body": {}
      },
      "expectedResponse": {
        "statusCode": 200,
        "checks": [
          "Response contains items array."
        ]
      },
      "dbExpectation": []
    },
    {
      "caseId": "ATTACH-API-002",
      "title": "Upload attachment content succeeds",
      "description": "Verify JSON upload content creates a database record and matching stored file.",
      "severity": "High",
      "precondition": [
        "User is authenticated.",
        "A defect exists."
      ],
      "requestMessage": {
        "method": "POST",
        "path": "/api/v1/defects/{{createdDefectId}}/attachments",
        "headers": {
          "Authorization": "Bearer {{global.accessToken}}"
        },
        "query": {},
        "body": {
          "filename": "invoice-error-{{global.runId}}.png",
          "contentType": "image/png",
          "fileSizeBytes": 68,
          "contentDataUrl": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+/p9sAAAAASUVORK5CYII="
        }
      },
      "expectedResponse": {
        "statusCode": 201,
        "checks": [
          "Response contains id.",
          "Response originalFilename matches request.",
          "Response contentUrl exists."
        ]
      },
      "dbExpectation": [
        "defect_attachments record is created.",
        "storage_key points to a physical file.",
        "attachment_uploaded history event is created."
      ]
    },
    {
      "caseId": "ATTACH-API-003",
      "title": "Upload attachment rejects unsupported extension",
      "description": "Verify unsupported attachment extensions are rejected.",
      "severity": "High",
      "precondition": [
        "User is authenticated.",
        "A defect exists."
      ],
      "requestMessage": {
        "method": "POST",
        "path": "/api/v1/defects/{{createdDefectId}}/attachments",
        "headers": {
          "Authorization": "Bearer {{global.accessToken}}"
        },
        "query": {},
        "body": {
          "filename": "defects-{{global.runId}}.csv",
          "contentType": "text/csv",
          "fileSizeBytes": 100,
          "contentDataUrl": "data:text/csv;base64,YSxi"
        }
      },
      "expectedResponse": {
        "statusCode": 400,
        "checks": [
          "Response error.code is validation_error.",
          "Response explains allowed file types."
        ]
      },
      "dbExpectation": [
        "No attachment is created."
      ]
    },
    {
      "caseId": "ATTACH-API-004",
      "title": "Upload attachment rejects invalid defect",
      "description": "Verify missing defect ID is handled before metadata insert.",
      "severity": "High",
      "precondition": [
        "User is authenticated."
      ],
      "requestMessage": {
        "method": "POST",
        "path": "/api/v1/defects/{{missingDefectId}}/attachments",
        "headers": {
          "Authorization": "Bearer {{global.accessToken}}"
        },
        "query": {},
        "body": {
          "filename": "invoice-error-{{global.runId}}.png",
          "contentType": "image/png",
          "fileSizeBytes": 68,
          "contentDataUrl": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+/p9sAAAAASUVORK5CYII="
        }
      },
      "expectedResponse": {
        "statusCode": 404,
        "checks": [
          "Response indicates defect not found."
        ]
      },
      "dbExpectation": [
        "No attachment is created."
      ]
    },
    {
      "caseId": "ATTACH-API-005",
      "title": "Delete attachment succeeds",
      "description": "Verify attachment delete is soft delete.",
      "severity": "High",
      "precondition": [
        "User is authenticated.",
        "A defect attachment exists."
      ],
      "requestMessage": {
        "method": "DELETE",
        "path": "/api/v1/defects/{{createdDefectId}}/attachments/{{createdAttachmentId}}",
        "headers": {
          "Authorization": "Bearer {{global.accessToken}}"
        },
        "query": {},
        "body": {}
      },
      "expectedResponse": {
        "statusCode": 204,
        "checks": [
          "Empty response body is returned."
        ]
      },
      "dbExpectation": [
        "defect_attachments is_deleted is true.",
        "attachment_deleted history event is created."
      ]
    },
    {
      "caseId": "ATTACH-API-006",
      "title": "Delete attachment not found",
      "description": "Verify missing attachment returns not found.",
      "severity": "Medium",
      "precondition": [
        "User is authenticated.",
        "A defect exists."
      ],
      "requestMessage": {
        "method": "DELETE",
        "path": "/api/v1/defects/{{createdDefectId}}/attachments/{{missingAttachmentId}}",
        "headers": {
          "Authorization": "Bearer {{global.accessToken}}"
        },
        "query": {},
        "body": {}
      },
      "expectedResponse": {
        "statusCode": 404,
        "checks": [
          "Response indicates attachment not found."
        ]
      },
      "dbExpectation": []
    },
    {
      "caseId": "ATTACH-API-007",
      "title": "Get attachment content succeeds",
      "description": "Verify current API streams the stored attachment bytes.",
      "severity": "Medium",
      "precondition": [
        "User is authenticated.",
        "An attachment exists.",
        "The attachment storage_key points to a physical file."
      ],
      "requestMessage": {
        "method": "GET",
        "path": "/api/v1/defects/{{createdDefectId}}/attachments/{{createdAttachmentId}}/content",
        "headers": {
          "Authorization": "Bearer {{global.accessToken}}"
        },
        "query": {},
        "body": {}
      },
      "expectedResponse": {
        "statusCode": 200,
        "checks": [
          "Response bytes match the uploaded attachment.",
          "Content-Disposition is an attachment download."
        ]
      },
      "dbExpectation": []
    },
    {
      "caseId": "ATTACH-API-008",
      "title": "Get attachment content not found",
      "description": "Verify missing attachment content returns not found.",
      "severity": "Medium",
      "precondition": [
        "User is authenticated.",
        "A defect exists."
      ],
      "requestMessage": {
        "method": "GET",
        "path": "/api/v1/defects/{{createdDefectId}}/attachments/{{missingAttachmentId}}/content",
        "headers": {
          "Authorization": "Bearer {{global.accessToken}}"
        },
        "query": {},
        "body": {}
      },
      "expectedResponse": {
        "statusCode": 404,
        "checks": [
          "Response indicates attachment not found."
        ]
      },
      "dbExpectation": []
    },
    {
      "caseId": "ATTACH-API-009",
      "title": "Upload attachment rejects empty body",
      "description": "Verify attachment upload requires filename and file content.",
      "severity": "High",
      "precondition": [
        "User is authenticated.",
        "A defect exists."
      ],
      "requestMessage": {
        "method": "POST",
        "path": "/api/v1/defects/{{createdDefectId}}/attachments",
        "headers": {
          "Authorization": "Bearer {{global.accessToken}}"
        },
        "query": {},
        "body": {}
      },
      "expectedResponse": {
        "statusCode": 400,
        "checks": [
          "Response error.code is validation_error.",
          "Response identifies missing filename or file content."
        ]
      },
      "dbExpectation": [
        "No attachment is created."
      ]
    },
    {
      "caseId": "ATTACH-API-010",
      "title": "Attachment list requires bearer token",
      "description": "Verify attachment list is protected by bearer authentication.",
      "severity": "Critical",
      "precondition": [
        "A defect exists."
      ],
      "requestMessage": {
        "method": "GET",
        "path": "/api/v1/defects/{{createdDefectId}}/attachments",
        "headers": {},
        "query": {},
        "body": {}
      },
      "expectedResponse": {
        "statusCode": 401,
        "checks": [
          "Response error.code is unauthorized."
        ]
      },
      "dbExpectation": []
    }
  ]
}